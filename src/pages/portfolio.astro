---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { Image, getImage } from "astro:assets";
import { portfolioImages } from "../content/images.config";

const siteUrl = "https://niopictures.com";

const sectionDefs = [
  {
    id: "housewarming",
    heading: "Housewarming Celebrations",
    intro: "The rituals, the gathered family, the new home — covered as it actually happens.",
    category: "housewarming-photography",
    order: [
      "portfolio-housewarming-couple",
      "portfolio-housewarming-garland",
      "portfolio-housewarming-exterior",
      "portfolio-housewarming-candid",
      "portfolio-housewarming-ritual",
      "portfolio-idol-detail",
      "portfolio-housewarming-family",
      "portfolio-fireceremony",
    ],
  },
  {
    id: "halfsaree",
    heading: "Half-Saree Ceremonies",
    intro: "A milestone celebration captured from the ceremony itself through to the family portraits after.",
    category: "half-saree-photography",
    order: [
      "portfolio-halfsaree-family",
      "portfolio-halfsaree-application",
      "portfolio-halfsaree-tilak",
      "portfolio-halfsaree-sisters",
      "portfolio-halfsaree-solo",
      "portfolio-halfsaree-grandparents",
      "portfolio-halfsaree-gift",
      "portfolio-halfsaree-henna-detail",
    ],
  },
  {
    id: "events",
    heading: "Celebrations & Events",
    intro: "Candid energy and genuine moments from get-togethers, milestone birthdays, and gatherings across the Houston area.",
    category: "event-photography",
    order: [
      "portfolio-group-kurtas",
      "portfolio-venue-night",
      "portfolio-couple-stringlights",
      "portfolio-couple-entryway",
      "portfolio-cakecutting",
      "portfolio-floral-detail",
      "portfolio-events-1",
      "portfolio-events-2",
    ],
  },
  {
    id: "family",
    heading: "Family Portraits",
    intro: "Warm, connected portraits that hold up as a keepsake, not just a posed afternoon.",
    category: "family-photography",
    order: [
      "portfolio-family-goldenhour",
      "portfolio-mothers-embrace",
      "portfolio-family-stairs",
      "portfolio-family-1",
      "portfolio-family-2",
    ],
  },
  {
    id: "editorial",
    heading: "Editorial Portraits",
    intro: "Studio-style portraiture with clean light and real presence — including festival season sessions.",
    category: "editorial-portraiture",
    order: [
      "portfolio-editorial-bokeh",
      "portfolio-diwali-sherwani",
      "portfolio-diwali-redsaree",
      "portfolio-diwali-seafoam",
      "portfolio-diwali-maroonblouse",
      "portfolio-diwali-dancepose",
      "portfolio-diwali-couple",
      "portfolio-diwali-bluefloral",
      "portfolio-diwali-redscarf",
      "portfolio-editorial-1",
    ],
  },
];

type PortfolioItem = (typeof portfolioImages)[0];

function sortSection(items: PortfolioItem[], order: string[]): PortfolioItem[] {
  return [
    ...order
      .map((key) => items.find((item) => item.key === key))
      .filter((x): x is PortfolioItem => x !== undefined),
    ...items.filter((item) => !order.includes(item.key)),
  ];
}

const sections = sectionDefs.map((def) => ({
  ...def,
  items: sortSection(
    portfolioImages.filter((item) => item.category === def.category),
    def.order
  ),
}));

// Global ordered array (all 39 in section order) for lightbox navigation
const orderedImages = sections.flatMap((s) => s.items);

const lightboxImages = await Promise.all(
  orderedImages.map((item) =>
    getImage({
      src: item.img,
      widths: [800, 1200, 1600, 2000],
      format: "webp",
      quality: 85,
    })
  )
);

// Map img.src → global lightbox index
const globalIndexMap = new Map(orderedImages.map((item, i) => [item.img.src, i]));

const title =
  "Portfolio | South Asian Celebrations & Family Photography | NiO Pictures Katy TX";
const description =
  "Browse NiO Pictures' photography portfolio — housewarmings, half-saree ceremonies, celebrations, and heirloom family portraits from Katy, Houston, Sugar Land & Richmond TX.";
const canonical = "https://niopictures.com/portfolio";
const ogImage = "https://niopictures.com/assets/images/og-home.webp";

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://niopictures.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Portfolio",
      item: "https://niopictures.com/portfolio",
    },
  ],
};

const associatedMedia = orderedImages.map((image) => ({
  "@type": "ImageObject",
  name: `${image.label} | NiO Pictures`,
  contentUrl: `${siteUrl}${image.img.src}`,
  description: image.alt,
  creator: { "@type": "Person", name: "Palanivel" },
  creditText: "NiO Pictures",
  license: "https://niopictures.com/terms",
  acquireLicensePage: "https://niopictures.com/contact",
  copyrightNotice: "© 2026 NiO Pictures. All Rights Reserved.",
}));

const imageGalleryLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "Event & Family Photography Portfolio | NiO Pictures",
  description:
    "Curated selection of cinematic event photography and heirloom family portraits from Katy, Houston, Sugar Land, and Richmond TX by photographer Palanivel.",
  url: "https://niopictures.com/portfolio",
  associatedMedia,
  author: {
    "@type": "Person",
    name: "Palanivel",
    url: "https://niopictures.com/about",
  },
  copyrightHolder: { "@id": "https://niopictures.com/#business" },
};

const extraHead = `<script type="application/ld+json">${JSON.stringify(breadcrumbLd)}</script>
<script type="application/ld+json">${JSON.stringify(imageGalleryLd)}</script>`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
>
  <Fragment slot="head" set:html={extraHead} />
  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'">Skip to main content</a
  >

  <Nav currentPath="/portfolio" />

  <main id="main-content">
    <!-- ── Header ─────────────────────────────────────────────── -->
    <section class="port-header">
      <div class="container">
        <div class="reveal">
          <p class="eyebrow" style="margin-bottom:1rem;">Selected Work</p>
          <div class="gold-line gold-line-animate"></div>
          <h1 class="display-xl port-header-title">
            Portfolio — Katy TX<br />
            <em style="font-style:italic; color:var(--gold);">South Asian Celebrations &amp; Family Photography</em>
          </h1>
          <p class="body-lg port-header-intro">
            A growing collection of real moments from real celebrations — browse
            the full set right here, no need to go anywhere else.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Categorized Masonry Sections ──────────────────────── -->
    {
      sections.map((section) => (
        <section class="port-section">
          <div class="container">
            <h2 class="display-md port-section-heading">{section.heading}</h2>
            <p class="body-sm port-section-intro">{section.intro}</p>
            <div class="port-grid">
              {section.items.map((item) => {
                const gIdx = globalIndexMap.get(item.img.src) ?? 0;
                return (
                  <button
                    class="port-grid-item"
                    data-index={gIdx}
                    aria-label={`View ${item.label}`}
                    type="button"
                  >
                    <Image
                      src={item.img}
                      alt={item.alt}
                      widths={[400, 600, 800]}
                      sizes="(max-width: 767px) calc(50vw - 1.5rem), (max-width: 1099px) calc(33.33vw - 1.5rem), calc(25vw - 1.5rem)"
                      loading={gIdx < 4 ? "eager" : "lazy"}
                      fetchpriority={gIdx === 0 ? "high" : undefined}
                      quality={85}
                    />
                  </button>
                );
              })}
            </div>
          </div>
        </section>
      ))
    }

    <!-- Image data for lightbox (in section order: housewarming → halfsaree → events → family → editorial) -->
    <script
      id="port-data"
      type="application/json"
      set:html={JSON.stringify(
        orderedImages.map((item, i) => ({
          src: item.img.src,
          lbSrc: lightboxImages[i].src,
          lbSrcset: lightboxImages[i].srcSet.attribute,
          alt: item.alt,
          category: item.category,
          label: item.label,
          caption: item.caption,
          lbWidth: item.img.width,
          lbHeight: item.img.height,
        }))
      )}
    ></script>

    <!-- ── Lightbox ───────────────────────────────────────────── -->
    <div
      class="port-lb"
      id="port-lb"
      role="dialog"
      aria-modal="true"
      aria-label="Image lightbox"
      hidden
    >
      <div class="port-lb-backdrop" id="port-lb-backdrop"></div>
      <div class="port-lb-inner">
        <button class="port-lb-close" id="port-lb-close" aria-label="Close lightbox" type="button">×</button>
        <button class="port-lb-arrow port-lb-prev" id="port-lb-prev" aria-label="Previous image" type="button">&#8592;</button>
        <button class="port-lb-arrow port-lb-next" id="port-lb-next" aria-label="Next image" type="button">&#8594;</button>
        <div class="port-lb-stage">
          <img class="port-lb-img" id="port-lb-img" src="" srcset="" sizes="90vw" alt="" />
        </div>
        <div class="port-lb-meta">
          <p class="port-lb-category eyebrow" id="port-lb-category"></p>
          <p class="port-lb-label" id="port-lb-label"></p>
          <p class="port-lb-caption" id="port-lb-caption"></p>
        </div>
        <p class="port-lb-counter" id="port-lb-counter"></p>
      </div>
    </div>

    <!-- ── CTA ───────────────────────────────────────────────── -->
    <section class="port-cta reveal">
      <div class="container">
        <div class="port-cta-inner">
          <div>
            <p class="eyebrow" style="margin-bottom:0.75rem;">
              If This Feels Like Your Family or Your Event
            </p>
            <h2 class="display-md port-cta-title">Let's Talk.</h2>
          </div>
          <div class="port-cta-actions">
            <a href="/contact" class="btn btn-primary btn-arrow"
              >Start a Conversation</a
            >
          </div>
          <div class="port-cta-links">
            <a href="/event-photography-katy-tx" class="port-text-link"
              >Event Photography →</a
            >
            <a href="/family-photography-katy-tx" class="port-text-link"
              >Family Sessions →</a
            >
            <a
              href="https://niopictures.pixieset.com/booking/"
              target="_blank"
              rel="noopener noreferrer"
              class="port-text-link">Prefer to self-book? →</a
            >
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ── Section layout ───────────────────────────────────────── */
  .port-section {
    padding: clamp(2rem, 4vw, 3rem) 0;
  }

  .port-section-heading {
    margin-bottom: 0.75rem;
  }

  .port-section-intro {
    margin-bottom: 1.5rem;
    max-width: 60ch;
  }

  /* ── Masonry grid ─────────────────────────────────────────── */
  .port-grid {
    column-count: 2;
    column-gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .port-grid {
      column-count: 3;
    }
  }

  @media (min-width: 1400px) {
    .port-grid {
      column-count: 4;
    }
  }

  .port-grid-item {
    display: block;
    width: 100%;
    margin-bottom: 1.25rem;
    break-inside: avoid;
    cursor: pointer;
    overflow: hidden;
    border-radius: 2px;
    background: var(--surface-2);
    padding: 0;
    border: none;
    position: relative;
    transition: opacity var(--dur-base) var(--ease);
  }

  .port-grid-item:hover {
    opacity: 0.88;
  }

  .port-grid-item:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .port-grid-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--dur-slow) var(--ease);
  }

  .port-grid-item:hover img {
    transform: scale(1.04);
  }

  /* ── Lightbox ─────────────────────────────────────────────── */
  .port-lb {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease);
  }

  .port-lb.lb-open {
    opacity: 1;
  }

  .port-lb[hidden] {
    display: none;
  }

  .port-lb-backdrop {
    position: absolute;
    inset: 0;
    background: var(--black-a95);
    cursor: pointer;
  }

  .port-lb-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 900px;
    max-height: 100svh;
    padding: 4rem 1.5rem 2rem;
    box-sizing: border-box;
    overflow-y: auto;
  }

  .port-lb-stage {
    width: 100%;
    display: flex;
    justify-content: center;
    transition: opacity var(--dur-base) var(--ease), transform var(--dur-base) var(--ease);
  }

  .port-lb-stage.lb-fade {
    opacity: 0;
    transform: scale(0.97);
  }

  .port-lb-img {
    max-width: 100%;
    max-height: 65svh;
    object-fit: contain;
    border-radius: 2px;
    display: block;
  }

  .port-lb-meta {
    text-align: center;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .port-lb-category {
    color: var(--gold);
    margin: 0;
  }

  .port-lb-label {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 300;
    color: var(--cream);
    margin: 0;
  }

  .port-lb-caption {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 48ch;
    margin: 0;
  }

  .port-lb-counter {
    font-family: var(--font-accent);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    color: var(--muted-dark);
    margin-top: 1.25rem;
    text-transform: uppercase;
  }

  .port-lb-close {
    position: fixed;
    top: 1.25rem;
    right: 1.5rem;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0.25rem 0.5rem;
    transition: color var(--dur-fast) var(--ease);
    z-index: 2;
  }

  .port-lb-close:hover {
    color: var(--gold);
  }

  .port-lb-arrow {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.4rem;
    color: var(--muted);
    cursor: pointer;
    background: rgba(22, 20, 18, 0.6);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.75rem 0.9rem;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
    z-index: 2;
    line-height: 1;
  }

  .port-lb-arrow:hover {
    color: var(--gold);
    border-color: var(--gold);
    background: rgba(22, 20, 18, 0.85);
  }

  .port-lb-prev {
    left: 1rem;
  }

  .port-lb-next {
    right: 1rem;
  }

  @media (max-width: 600px) {
    .port-lb-arrow {
      top: auto;
      bottom: 5.5rem;
      transform: none;
      padding: 0.6rem 0.75rem;
      font-size: 1.1rem;
    }
    .port-lb-prev { left: 1rem; }
    .port-lb-next { right: 1rem; }
  }
</style>

<script>
  (function () {
    const portData: { src: string; lbSrc: string; lbSrcset: string; alt: string; category: string; label: string; caption: string; lbWidth: number; lbHeight: number }[] =
      JSON.parse(document.getElementById("port-data")?.textContent || "[]");

    const lb        = document.getElementById("port-lb") as HTMLElement;
    const backdrop  = document.getElementById("port-lb-backdrop") as HTMLElement;
    const stage     = lb?.querySelector(".port-lb-stage") as HTMLElement;
    const img       = document.getElementById("port-lb-img") as HTMLImageElement;
    const catEl     = document.getElementById("port-lb-category") as HTMLElement;
    const labelEl   = document.getElementById("port-lb-label") as HTMLElement;
    const captionEl = document.getElementById("port-lb-caption") as HTMLElement;
    const counterEl = document.getElementById("port-lb-counter") as HTMLElement;
    const closeBtn  = document.getElementById("port-lb-close") as HTMLButtonElement;
    const prevBtn   = document.getElementById("port-lb-prev") as HTMLButtonElement;
    const nextBtn   = document.getElementById("port-lb-next") as HTMLButtonElement;

    if (!lb || !portData.length) return;

    let current = 0;
    let triggerEl: HTMLElement | null = null;
    const total = portData.length;
    let loadGen = 0;

    function show(index: number) {
      const d = portData[index];
      const gen = ++loadGen;

      // Update meta immediately — no need to wait for the image
      img.alt = d.alt;
      catEl.textContent = d.category.replace(/-/g, " ");
      labelEl.textContent = d.label;
      captionEl.textContent = d.caption;
      counterEl.textContent = `${index + 1} / ${total}`;

      const fadeDuration =
        parseFloat(getComputedStyle(stage).transitionDuration) * 1000 || 200;

      stage.classList.add("lb-fade");

      setTimeout(() => {
        if (gen !== loadGen) return;
        // Reserve layout space so there is no size jump when the image arrives
        img.style.aspectRatio = `${d.lbWidth} / ${d.lbHeight}`;
        // Keep stage faded while preloading — only unfade once the image is ready
        const preloader = new Image();
        preloader.sizes = "90vw";
        const reveal = () => {
          if (gen !== loadGen) return;
          img.src = d.lbSrc;
          img.srcset = d.lbSrcset;
          stage.classList.remove("lb-fade");
        };
        preloader.onload = reveal;
        preloader.onerror = reveal;
        preloader.srcset = d.lbSrcset;
        preloader.src = d.lbSrc;
      }, fadeDuration);
    }

    function open(index: number, trigger: HTMLElement) {
      current = index;
      triggerEl = trigger;
      gtag("event", "portfolio_view", {
        category: portData[index].category,
        label: portData[index].label,
        page_path: window.location.pathname,
      });
      lb.removeAttribute("hidden");
      requestAnimationFrame(() => lb.classList.add("lb-open"));
      show(current);
      document.body.style.overflow = "hidden";
      trapFocus();
      closeBtn.focus();
    }

    function close() {
      lb.classList.remove("lb-open");
      lb.addEventListener("transitionend", () => {
        lb.setAttribute("hidden", "");
        document.body.style.overflow = "";
        removeFocusTrap();
        if (triggerEl) triggerEl.focus();
      }, { once: true });
    }

    function navigate(dir: number) {
      current = (current + dir + total) % total;
      show(current);
    }

    // Focus trap
    let focusTrapHandler: ((e: KeyboardEvent) => void) | null = null;
    function trapFocus() {
      focusTrapHandler = (e: KeyboardEvent) => {
        if (e.key === "Escape") { close(); return; }
        if (e.key === "ArrowLeft")  { navigate(-1); return; }
        if (e.key === "ArrowRight") { navigate(1);  return; }
        if (e.key !== "Tab") return;
        const focusable = Array.from(
          lb.querySelectorAll<HTMLElement>("button, [tabindex='0']")
        ).filter(el => !el.hasAttribute("hidden"));
        if (!focusable.length) return;
        const first = focusable[0];
        const last  = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus();
        }
      };
      document.addEventListener("keydown", focusTrapHandler);
    }
    function removeFocusTrap() {
      if (focusTrapHandler) document.removeEventListener("keydown", focusTrapHandler);
      focusTrapHandler = null;
    }

    // Grid item clicks — data-index is the global lightbox index
    document.querySelectorAll<HTMLButtonElement>(".port-grid-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = parseInt(btn.dataset.index || "0", 10);
        open(idx, btn);
      });
    });

    closeBtn.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    prevBtn.addEventListener("click", () => navigate(-1));
    nextBtn.addEventListener("click", () => navigate(1));
  })();
</script>
