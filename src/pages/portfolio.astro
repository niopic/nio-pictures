---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { portfolioImages } from "../content/images.config";

const [leadImage, ...stackImages] = portfolioImages;
const siteUrl = "https://niopictures.com";

const title =
  "Portfolio | Event & Family Photography Gallery | NiO Pictures Katy TX";
const description =
  "Browse NiO Pictures' photography portfolio. Cinematic events and heirloom family portraits from Katy, Houston, Sugar Land & Richmond TX.";
const canonical = "https://niopictures.com/portfolio";
const ogImage = "https://niopictures.com/assets/images/og-home.webp";
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://niopictures.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Portfolio",
      item: "https://niopictures.com/portfolio",
    },
  ],
};

const associatedMedia = portfolioImages.map((image) => ({
  "@type": "ImageObject",
  name: `${image.label} | NiO Pictures`,
  contentUrl: `${siteUrl}${image.img.src}`,
  description: image.alt,
  creator: { "@type": "Person", name: "Palanivel" },
  creditText: "NiO Pictures",
  license: "https://niopictures.com/terms",
  acquireLicensePage: "https://niopictures.com/contact",
}));

const imageGalleryLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "Event & Family Photography Portfolio | NiO Pictures",
  description:
    "Curated selection of cinematic event photography and heirloom family portraits from Katy, Houston, Sugar Land, and Richmond TX by photographer Palanivel.",
  url: "https://niopictures.com/portfolio",
  associatedMedia,
  author: {
    "@type": "Person",
    name: "Palanivel",
    url: "https://niopictures.com/about",
  },
  copyrightHolder: { "@id": "https://niopictures.com/#business" },
};

const extraHead = `<script type="application/ld+json">${JSON.stringify(breadcrumbLd)}</script>
<script type="application/ld+json">${JSON.stringify(imageGalleryLd)}</script>`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
>
  <Fragment slot="head" set:html={extraHead} />
  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'">Skip to main content</a
  >

  <nav class="nav" role="navigation" aria-label="Main navigation">
    <a href="/" class="nav-logo">Ni<span>O</span> Pictures</a>
    <div class="nav-links">
      <a href="/event-photography-katy-tx">Events</a>
      <a href="/family-photography-katy-tx">Family</a>
      <a href="/portfolio" class="active">Portfolio</a>
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
    </div>
    <a
      href="https://niopictures.pixieset.com/booking/"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary nav-cta">Book Now</a
    >
    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false"
      ><span></span><span></span><span></span></button
    >
  </nav>

  <div class="nav-mobile" role="dialog" aria-label="Mobile navigation">
    <a href="/event-photography-katy-tx">Events</a>
    <a href="/family-photography-katy-tx">Family</a>
    <a href="/portfolio">Portfolio</a>
    <a href="/about">About</a>
    <a href="/blog">Blog</a>
    <a href="/contact">Contact</a>
    <a
      href="https://niopictures.pixieset.com/booking/"
      target="_blank"
      rel="noopener noreferrer"
      class="nav-mobile-cta">Book a Session →</a
    >
  </div>

  <main id="main-content">
    <section class="port-header">
      <div class="container">
        <div class="reveal">
          <p class="eyebrow" style="margin-bottom:1rem;">Selected Work</p>
          <div class="gold-line gold-line-animate"></div>
          <h1 class="display-xl port-header-title">
            Portfolio — Katy TX<br />
            <em style="font-style:italic; color:var(--gold);">Event &amp; Family Photography</em>
          </h1>
          <p class="body-lg port-header-intro">
            A curated edit of event photography, family portraits, and editorial
            frames made across Katy TX and the Houston area.
          </p>
        </div>
      </div>
    </section>

    <section class="port-lead-section">
      <div class="port-lead-grid">
        <figure class="port-lead-image reveal">
          <Image
            src={leadImage.img}
            alt={leadImage.alt}
            loading="eager"
            fetchpriority="high"
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 768px) 100vw, 55vw"
            quality={90}
          />
        </figure>

        <aside class="port-note reveal">
          <p class="port-kicker">A Small Note</p>
          <h2 class="display-md port-note-title">Enough to feel the work.</h2>
          <p class="port-note-copy">
            Every image here was chosen deliberately. This is a curated
            selection — enough to feel the work, not everything I've ever shot.
            The full gallery lives on Pixieset, and each route below shows the
            work in context.
          </p>
          <div class="port-note-links">
            <a
              href="https://niopictures.pixieset.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="port-text-link"
            >
              Full Gallery →
            </a>
            <a href={leadImage.link} class="port-text-link">
              {leadImage.linkText} →
            </a>
          </div>
        </aside>
      </div>

      <div class="container">
        <div class="port-caption reveal">
          <p class="port-label">{leadImage.label}</p>
          <p class="port-caption-text">{leadImage.caption}</p>
          <a href={leadImage.link} class="port-text-link"
            >{leadImage.linkText} →</a
          >
        </div>
      </div>
    </section>

    {
      stackImages.map((item) => (
        <section class="port-frame-section reveal">
          <div class="container">
            <figure class="port-frame">
              <Image
                src={item.img}
                alt={item.alt}
                loading="lazy"
                widths={[480, 900, 1600]}
                sizes="100vw"
                quality={90}
              />
            </figure>
            <div class="port-caption reveal">
              <p class="port-label">{item.label}</p>
              <p class="port-caption-text">{item.caption}</p>
              <a href={item.link} class="port-text-link">
                {item.linkText} →
              </a>
            </div>
          </div>
        </section>
      ))
    }

    <section class="port-cta reveal">
      <div class="container">
        <div class="port-cta-inner">
          <div>
            <p class="eyebrow" style="margin-bottom:0.75rem;">
              If This Feels Like Your Family or Your Event
            </p>
            <h2 class="display-md port-cta-title">Let's Talk.</h2>
          </div>
          <div class="port-cta-actions">
            <a
              href="https://niopictures.pixieset.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline">Full Gallery</a
            >
            <a
              href="https://niopictures.pixieset.com/booking/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-arrow">Book a Session</a
            >
          </div>
          <div class="port-cta-links">
            <a href="/event-photography-katy-tx" class="port-text-link"
              >Event Photography →</a
            >
            <a href="/family-photography-katy-tx" class="port-text-link"
              >Family Sessions →</a
            >
            <a href="/contact" class="port-text-link">Ask About Your Date →</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
