---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { fulshearImages } from "../content/images.config";
const title =
  "Fulshear Photographer | South Asian Celebrations & Family Portraits | NiO Pictures";
const description =
  "Fulshear TX photographer specializing in South Asian celebrations and heirloom family portraits. Based in Katy TX, serving Fulshear and the surrounding area.";
const canonical = "https://niopictures.com/fulshear-tx-photographer";
const ogImage = "https://niopictures.com/assets/images/og-home.webp";
const extraHead =
  '<script type="application/ld+json">\n  {\n    "@context": "https://schema.org",\n    "@type": "BreadcrumbList",\n    "itemListElement": [\n      {"@type":"ListItem","position":1,"name":"Home","item":"https://niopictures.com/"},\n      {"@type":"ListItem","position":2,"name":"Fulshear Photographer","item":"https://niopictures.com/fulshear-tx-photographer"}\n    ]\n  }\n  </script>\n<script type="application/ld+json">\n  {\n    "@context": "https://schema.org",\n    "@type": "FAQPage",\n    "mainEntity": [\n      {\n        "@type": "Question",\n        "name": "Do you photograph South Asian celebrations in Fulshear?",\n        "acceptedAnswer": {\n          "@type": "Answer",\n          "text": "Yes. NiO Pictures regularly photographs housewarmings, half-saree ceremonies, and other South Asian celebrations throughout Fulshear and the surrounding area."\n        }\n      },\n      {\n        "@type": "Question",\n        "name": "Do you travel from Katy to Fulshear for sessions?",\n        "acceptedAnswer": {\n          "@type": "Answer",\n          "text": "Yes. We offer both weekend and weeknight availability for Fulshear sessions throughout the year."\n        }\n      },\n      {\n        "@type": "Question",\n        "name": "Do you offer family portrait sessions in Fulshear?",\n        "acceptedAnswer": {\n          "@type": "Answer",\n          "text": "Yes. We provide heirloom family portrait sessions throughout Fulshear, available as prints, wall art, and keepsake albums."\n        }\n      }\n    ]\n  }\n  </script>';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
>
  <Fragment slot="head" set:html={extraHead} />
  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'">Skip to main content</a
  >

  <Nav />

  <div class="page-hero" style="margin-top: 0; padding-top: 0;">
    <div class="page-hero-bg" style="background-color: #18161a;">
      <Image
        src={fulshearImages.pageHero.img}
        alt={fulshearImages.pageHero.alt}
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1200, 1600, 1920]}
        sizes="100vw"
        quality={90}
        class="page-hero-bg-image"
        style="object-position: top center;"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content container">
      <p class="eyebrow" style="margin-bottom:1rem;">
        Serving Fulshear, Texas
      </p>
      <div class="gold-line gold-line-animate"></div>
      <h1 class="display-xl" style="max-width:700px; margin-bottom:1.25rem;">
        Fulshear<br /><em style="font-style:italic; color:var(--gold);"
          >Photographer</em
        >
      </h1>
      <p class="body-lg" style="max-width:580px; margin-bottom:0;">
        NiO Pictures serves Fulshear and the surrounding area — South Asian celebrations, milestone events, and heirloom family portraits.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header center reveal">
        <p class="eyebrow">Photography in Fulshear TX</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">
          Fulshear Family and Event Photography Services
        </h2>
      </div>
      <div class="features-grid reveal reveal-delay-1">
        <div class="feature-card">
          <div class="feature-icon">◇</div>
          <h3 class="feature-title">South Asian Celebrations</h3>
          <p class="body-sm">
            Housewarmings, half-saree ceremonies, milestone birthdays, and
            cultural celebrations throughout Fulshear and the surrounding area.
            Candid, cinematic, professionally delivered.
          </p>
          <a
            href="/event-photography-katy-tx"
            style="display:inline-flex;align-items:center;gap:0.4rem;font-family:var(--font-accent);font-size:0.6rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--gold);margin-top:1.25rem;"
            >Event Photography →</a
          >
        </div>
        <div class="feature-card">
          <div class="feature-icon">◈</div>
          <h3 class="feature-title">Family Photography</h3>
          <p class="body-sm">
            Heirloom family portraits and lifestyle sessions for Fulshear
            families. Natural, unscripted, and available as wall art, prints,
            and keepsake albums.
          </p>
          <a
            href="/family-photography-katy-tx"
            style="display:inline-flex;align-items:center;gap:0.4rem;font-family:var(--font-accent);font-size:0.6rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--gold);margin-top:1.25rem;"
            >Family Photography →</a
          >
        </div>
        <div class="feature-card">
          <div class="feature-icon">◉</div>
          <h3 class="feature-title">Weekends & Weeknights</h3>
          <p class="body-sm">
            Sessions available on weekends and weeknight evenings throughout
            Fulshear and the greater Houston area — no need to take time off
            work.
          </p>
          <a
            href="https://niopictures.pixieset.com/booking/"
            target="_blank"
            rel="noopener noreferrer"
            style="display:inline-flex;align-items:center;gap:0.4rem;font-family:var(--font-accent);font-size:0.6rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--gold);margin-top:1.25rem;"
            >Check Availability →</a
          >
        </div>
      </div>
    </div>
  </section>

  <section
    class="section"
    style="background:var(--surface); border-top:1px solid var(--border-light); border-bottom:1px solid var(--border-light);"
  >
    <div class="container" style="max-width:800px;">
      <div class="section-header center reveal">
        <p class="eyebrow">Why NiO Pictures</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">A Photographer Who Knows the Area</h2>
      </div>
      <p
        class="body-lg reveal"
        style="text-align:center; max-width:620px; margin:0 auto 2rem;"
      >
        NiO Pictures serves Fulshear and the surrounding area as part of a
        regular schedule across the Houston metro. Palanivel regularly
        photographs events and families throughout the Fulshear area, and knows
        the parks, natural light, and local event venues that make each session
        distinctive. Whether it's a milestone celebration or a family portrait
        session, every session gets the same cinematic care.
      </p>
      <div
        style="display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;"
        class="reveal"
      >
        <a href="/katy-tx-photographer" class="btn btn-gold-outline btn-arrow"
          >Katy TX (Home Base)</a
        >
        <a href="/portfolio" class="btn btn-gold-outline btn-arrow"
          >See Event &amp; Family Portfolio</a
        >
        <a href="/about" class="btn btn-outline">About Palanivel</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:900px;">
      <div class="section-header center reveal">
        <p class="eyebrow">Fulshear Area Insight</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">
          Growing Community, Timeless Photography
        </h2>
      </div>
      <p
        class="body-lg reveal"
        style="text-align:center; max-width:760px; margin:0 auto 1.25rem;"
      >
        The Fulshear area is experiencing steady growth, and we frequently
        photograph families and celebrations throughout the community.
      </p>
      <p
        class="body-lg reveal reveal-delay-1"
        style="text-align:center; max-width:760px; margin:0 auto 1.25rem;"
      >
        For event coverage, we know how to move efficiently through local venues
        and outdoor spaces without missing candid moments - from cultural
        ceremonies to family gatherings.
      </p>
      <p
        class="body-lg reveal reveal-delay-2"
        style="text-align:center; max-width:760px; margin:0 auto;"
      >
        We serve Fulshear consistently because many families here are creating
        new traditions and want a photographer who understands the cultural
        significance of their celebrations and can be trusted to return to year
        after year.
      </p>
      <div
        style="display:flex; gap:1rem; flex-wrap:wrap; justify-content:center; margin-top:2rem;"
        class="reveal"
      >
        <a
          href="/event-photography-katy-tx"
          class="btn btn-gold-outline btn-arrow"
          >Fulshear Event Photography Services</a
        >
        <a href="/family-photography-katy-tx" class="btn btn-outline"
          >Fulshear Family Photography Services</a
        >
      </div>
    </div>
  </section>

  <section class="cta-banner reveal">
    <div class="container">
      <p class="eyebrow" style="margin-bottom:1.25rem;">
        Fulshear TX Photography
      </p>
      <h2
        class="display-md"
        style="margin-bottom:1rem; max-width:520px; margin-left:auto; margin-right:auto;"
      >
        Book Your Session<br /><em style="font-style:italic; color:var(--gold);"
          >in Fulshear</em
        >
      </h2>
      <p class="body-lg" style="max-width:420px; margin:0 auto 2.5rem;">
        Events and family sessions available throughout Fulshear, Katy, and the
        greater metro area.
      </p>
      <div
        style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;"
      >
        <a href="/contact" class="btn btn-primary btn-arrow"
          >Start a Conversation</a
        >
        <a href="/contact" class="btn btn-outline">Get in Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>
