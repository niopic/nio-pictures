---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import PricingSection from "../components/PricingSection.astro";

import { eventsImages } from "../content/images.config";

const siteUrl = "https://niopictures.com";
const eventHeroImagePath = eventsImages.pageHero.img.src;
const eventHeroImageUrl = `${siteUrl}${eventHeroImagePath}`;
const eventHeroImageLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ImageObject",
  name: "Event photography hero image",
  description:
    "Cinematic event photography in Katy, Houston, Sugar Land, and Richmond by NiO Pictures.",
  contentUrl: eventHeroImageUrl,
  url: eventHeroImageUrl,
  creditText: "NiO Pictures",
  creator: {
    "@type": "Person",
    name: "Palanivel",
  },
  license: "https://niopictures.com/terms",
  acquireLicensePage: "https://niopictures.com/contact",
});
---

<BaseLayout
  title="Event Photographer Katy TX | South Asian Celebrations & Housewarmings | NiO Pictures"
  description="Event photographer in Katy TX specializing in South Asian celebrations — housewarmings, half-saree ceremonies, milestone birthdays, and cultural events — alongside private parties and corporate coverage across Houston, Sugar Land & Richmond."
  canonical="https://niopictures.com/event-photography-katy-tx"
  ogImage="https://niopictures.com/assets/images/events-hero.webp"
>
  <fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={eventHeroImagePath}
      fetchpriority="high"
    />

    <script type="application/ld+json" is:inline set:html={eventHeroImageLd} />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://niopictures.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Event Photography Katy TX",
            "item": "https://niopictures.com/event-photography-katy-tx"
          }
        ]
      }
    </script>

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Event Photography in Katy TX",
        "serviceType": "Event Photography",
        "provider": { "@id": "https://niopictures.com/#business" },
        "areaServed": [
          {
            "@type": "City",
            "name": "Katy",
            "sameAs": "https://en.wikipedia.org/wiki/Katy,_Texas"
          },
          {
            "@type": "City",
            "name": "Houston",
            "sameAs": "https://en.wikipedia.org/wiki/Houston"
          },
          {
            "@type": "City",
            "name": "Sugar Land",
            "sameAs": "https://en.wikipedia.org/wiki/Sugar_Land,_Texas"
          },
          {
            "@type": "City",
            "name": "Richmond",
            "sameAs": "https://en.wikipedia.org/wiki/Richmond,_Texas"
          }
        ],
        "description": "Professional event photography specializing in South Asian celebrations — housewarmings, half-saree ceremonies, milestone birthdays, and cultural events — plus private celebrations and corporate events in Katy, Houston, Sugar Land, and Richmond TX.",
        "url": "https://niopictures.com/event-photography-katy-tx",
        "offers": {
          "@type": "Offer",
          "availability": "https://schema.org/InStock",
          "url": "https://niopictures.pixieset.com/booking/"
        }
      }
    </script>

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Do you photograph Indian and South Asian events in Katy TX?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. NiO Pictures specializes in Indian and South Asian cultural events including garba nights, sangeet, receptions, birthday milestones, and community celebrations throughout Katy, Houston, and Sugar Land, TX."
            }
          },
          {
            "@type": "Question",
            "name": "How far in advance should I book event photography in Katy TX?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We recommend booking at least 4-6 weeks in advance for private events, and 2-3 months ahead for larger corporate events or cultural celebrations to secure your preferred date."
            }
          },
          {
            "@type": "Question",
            "name": "Do you cover events in Houston and Sugar Land, not just Katy?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Absolutely. NiO Pictures is based in Katy TX but actively serves Houston, Sugar Land, and Richmond for all types of events - corporate, private, and cultural."
            }
          },
          {
            "@type": "Question",
            "name": "What is included in event photography coverage?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Every package includes 2-hour event coverage, professionally edited images in my cinematic style, and delivery via a private online gallery. Additional coverage hours are available — contact me for custom quotes."
            }
          },
          {
            "@type": "Question",
            "name": "Are you available on weekends and weeknights for events?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. NiO Pictures offers photography sessions on weekends and weeknight evenings throughout the Katy, Houston, Sugar Land, and Richmond areas."
            }
          }
        ]
      }
    </script>
  </fragment>

  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'">Skip to main content</a
  >

  <Nav currentPath="/event-photography-katy-tx" />

  <main id="main-content">
    <div class="page-hero" style="margin-top: 0; padding-top: 0;">
      <div class="page-hero-bg" style="background-color: #18161a;">
        <Image
          src={eventsImages.pageHero.img}
          alt={eventsImages.pageHero.alt}
          aria-hidden="true"
          loading="eager"
          fetchpriority="high"
          widths={[768, 1200, 1600, 1920]}
          sizes="100vw"
          quality={90}
          class="page-hero-bg-image"
        />
      </div>
      <div class="page-hero-overlay"></div>
      <div class="page-hero-content container">
        <p class="eyebrow" style="margin-bottom: 1rem;">
          Katy TX · Houston · Sugar Land · Richmond
        </p>
        <h1 class="display-xl" style="max-width: 680px;">
          Event Photographer<br /><em style="font-style:italic; color:var(--gold);"
            >in Katy TX</em
          >
        </h1>
        <p class="body-lg" style="max-width: 500px; margin-top: 1rem;">
          Event photography Katy TX for corporate events, private celebrations,
          and every meaningful gathering in between.
        </p>
      </div>
    </div>

    <section class="section">
      <div class="container">
        <div
          style="max-width: 720px; margin: 0 auto; text-align: center;"
          class="reveal"
        >
          <p class="eyebrow">The Approach</p>
          <div class="gold-line center gold-line-animate"></div>
          <h2 class="display-md" style="margin-bottom: 1.5rem;">
            Every Event Has a Story.<br /><em
              style="font-style:italic; color:var(--gold);"
              >I Tell It Beautifully.</em
            >
          </h2>
          <p class="body-lg">
            As a dedicated <strong style="color:var(--cream); font-weight:400;"
              >event photographer in Katy, TX</strong
            >, NiO Pictures approaches every event like a documentary filmmaker
            - invisible, observant, and always in the right place at the right
            moment. No stiff poses. No missed moments. Just authentic, cinematic
            imagery that captures the energy of your event exactly as it was.
          </p>
          <p class="body-lg" style="margin-top:1rem;">
            Serving Katy, Sugar Land, Houston, and the greater Fort Bend County area.
          </p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div class="features-grid features-grid-4">
          <article class="feature-card reveal">
            <div class="feature-icon">◇</div>
            <p class="eyebrow" style="margin-bottom: 0.75rem;">South Asian Celebrations</p>
            <h3 class="feature-title">Housewarmings & Cultural Milestones</h3>
            <p class="body-sm" style="color:var(--gold); font-style:italic; margin-bottom:0.5rem; font-size:0.8rem;">Housewarmings, half-saree ceremonies, Diwali, and the milestones that matter most.</p>
            <p class="body-sm">
              From Grihapravesam housewarmings to half-saree ceremonies, milestone birthdays, and
              Diwali celebrations — I photograph South Asian traditions with the care and cultural
              understanding they deserve. We also welcome and proudly photograph celebrations from
              every culture and tradition.
            </p>
            <ul
              style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.4rem;"
            >
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Housewarming (Grihapravesam) ceremonies
              </li>
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Half-saree &amp; coming-of-age milestones
              </li>
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Diwali &amp; festival celebrations
              </li>
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Milestone birthdays with cultural elements
              </li>
            </ul>
          </article>

          <article class="feature-card reveal reveal-delay-2">
            <div class="feature-icon">◆</div>
            <p class="eyebrow" style="margin-bottom: 0.75rem;">Private</p>
            <h3 class="feature-title">Private Events</h3>
            <p class="body-sm" style="color:var(--gold); font-style:italic; margin-bottom:0.5rem; font-size:0.8rem;">Birthdays, anniversaries, and the parties worth remembering.</p>
            <p class="body-sm">
              Birthdays, anniversaries, quinceañeras, and private celebrations — I capture the
              warmth, energy, and authentic detail of every gathering.
            </p>
            <ul
              style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.4rem;"
            >
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Birthday and milestone parties
              </li>
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Anniversary celebrations
              </li>
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Quinceañeras &amp; milestone parties
              </li>
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Candid and portrait mix
              </li>
            </ul>
          </article>

          <article class="feature-card reveal reveal-delay-3">
            <div class="feature-icon">◈</div>
            <p class="eyebrow" style="margin-bottom: 0.75rem;">Corporate</p>
            <h3 class="feature-title">Corporate Events</h3>
            <p class="body-sm" style="color:var(--gold); font-style:italic; margin-bottom:0.5rem; font-size:0.8rem;">Imagery that reflects your brand. Delivered fast.</p>
            <p class="body-sm">
              Conferences, galas, product launches, award ceremonies, and team
              events. Professional imagery that reflects your brand with polish
              and precision.
            </p>
            <ul
              style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.4rem;"
            >
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Corporate headshots on-site
              </li>
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Conference and keynote coverage
              </li>
            </ul>
          </article>

          <article class="feature-card reveal reveal-delay-4">
            <div class="feature-icon">◉</div>
            <p class="eyebrow" style="margin-bottom: 0.75rem;">Storytelling</p>
            <h3 class="feature-title">Candid Coverage</h3>
            <p class="body-sm">
              Real moments. Real emotions. My candid photography style ensures
              nothing authentic is missed - from the first handshake to the last
              dance.
            </p>
            <ul
              style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.4rem;"
            >
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Unobtrusive documentary
                style
              </li>
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Full-event timeline coverage
              </li>
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Emotion-first editing
              </li>
              <li class="body-sm" style="display:flex; gap:0.5rem;">
                <span style="color:var(--gold);">-</span> Online gallery delivery
              </li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section
      class="section"
      style="background: var(--surface); border-top: 1px solid var(--border-light);"
    >
      <div class="container">
        <div class="section-header center reveal">
          <p class="eyebrow">Event Gallery</p>
          <div class="gold-line center gold-line-animate"></div>
          <h2 class="display-md">From the Archives</h2>
        </div>

        <div class="featured-grid reveal reveal-delay-1">
          <div class="grid-item">
            <Image
              src={eventsImages.gridSlot1.img}
              alt={eventsImages.gridSlot1.alt}
              loading="lazy"
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              width={800}
              height={600}
              style="background:var(--surface-2)"
            />
          </div>
          <div class="grid-item">
            <Image
              src={eventsImages.gridSlot2.img}
              alt={eventsImages.gridSlot2.alt}
              loading="lazy"
              widths={[300, 400, 800]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              width={400}
              height={533}
              style="background:var(--surface-2)"
            />
          </div>
          <div class="grid-item">
            <Image
              src={eventsImages.gridSlot3.img}
              alt={eventsImages.gridSlot3.alt}
              loading="lazy"
              widths={[300, 400, 800]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              width={400}
              height={533}
              style="background:var(--surface-2)"
            />
          </div>
          <div class="grid-item">
            <Image
              src={eventsImages.gridSlot4.img}
              alt={eventsImages.gridSlot4.alt}
              loading="lazy"
              widths={[300, 400, 800]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              width={400}
              height={533}
              style="background:var(--surface-2)"
            />
          </div>
          <div class="grid-item">
            <Image
              src={eventsImages.gridSlot5.img}
              alt={eventsImages.gridSlot5.alt}
              loading="lazy"
              widths={[300, 400, 800]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              width={400}
              height={533}
              style="background:var(--surface-2)"
            />
          </div>
          <div class="grid-item">
            <Image
              src={eventsImages.gridSlot6.img}
              alt={eventsImages.gridSlot6.alt}
              loading="lazy"
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              width={800}
              height={600}
              style="background:var(--surface-2)"
            />
          </div>
        </div>

        <div style="text-align:center; margin-top: 3rem;" class="reveal">
          <a
            href="https://niopictures.pixieset.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-gold-outline btn-arrow">View Full Event Gallery</a
          >
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-header center reveal">
          <p class="eyebrow">How It Works</p>
          <div class="gold-line center gold-line-animate"></div>
          <h2 class="display-md">Simple. Seamless. Stunning.</h2>
        </div>

        <div class="process-steps reveal reveal-delay-1">
          <div class="process-step">
            <div class="step-number">01</div>
            <h3 class="display-sm">Consultation</h3>
            <p class="body-sm">
              I'll discuss your event, vision, must-have shots, and timeline -
              so nothing is left to chance.
            </p>
          </div>
          <div class="process-step">
            <div class="step-number">02</div>
            <h3 class="display-sm">Day-Of Coverage</h3>
            <p class="body-sm">
              I arrive early, stay late, and cover every moment with a
              cinematic, candid eye.
            </p>
          </div>
          <div class="process-step">
            <div class="step-number">03</div>
            <h3 class="display-sm">Culling and Edit</h3>
            <p class="body-sm">
              Every image is carefully selected and edited with my signature
              warm, cinematic style.
            </p>
          </div>
          <div class="process-step">
            <div class="step-number">04</div>
            <h3 class="display-sm">Gallery Delivery</h3>
            <p class="body-sm">
              Your private online gallery is delivered within 2-3 weeks, ready
              to download and share.
            </p>
          </div>
        </div>
      </div>
    </section>

    <PricingSection />

    <section class="section" id="faq" aria-label="Frequently asked questions">
      <div class="container" style="max-width: 820px;">
        <div class="section-header center reveal">
          <p class="eyebrow">Common Questions</p>
          <div class="gold-line center gold-line-animate"></div>
          <h2 class="display-md">Event Photography FAQs</h2>
        </div>
        <div
          style="display:flex; flex-direction:column; gap:0;"
          class="reveal reveal-delay-1"
        >
          <details
            style="border-bottom:1px solid var(--border-light); padding: 1.5rem 0;"
            open
          >
            <summary
              style="cursor:pointer; font-family:var(--font-display); font-size:1.15rem; font-weight:400; color:var(--cream); list-style:none; display:flex; justify-content:space-between; align-items:center; gap:1rem;"
              >Do you photograph Indian and South Asian events in Katy TX?<span
                style="color:var(--gold); font-size:1.2rem; flex-shrink:0;"
                >+</span
              ></summary
            >
            <p class="body-sm" style="margin-top:1rem; padding-right:2rem;">
              Yes. NiO Pictures specializes in Indian and South Asian cultural
              events - garba nights, sangeet, receptions, birthday milestones,
              and community celebrations throughout Katy, Houston, and Sugar
              Land, TX.
            </p>
          </details>

          <details
            style="border-bottom:1px solid var(--border-light); padding: 1.5rem 0;"
          >
            <summary
              style="cursor:pointer; font-family:var(--font-display); font-size:1.15rem; font-weight:400; color:var(--cream); list-style:none; display:flex; justify-content:space-between; align-items:center; gap:1rem;"
              >How far in advance should I book event photography?<span
                style="color:var(--gold); font-size:1.2rem; flex-shrink:0;"
                >+</span
              ></summary
            >
            <p class="body-sm" style="margin-top:1rem; padding-right:2rem;">
              I recommend booking at least 4-6 weeks ahead for private events,
              and 2-3 months for larger corporate events or cultural
              celebrations to secure your date.
            </p>
          </details>

          <details
            style="border-bottom:1px solid var(--border-light); padding: 1.5rem 0;"
          >
            <summary
              style="cursor:pointer; font-family:var(--font-display); font-size:1.15rem; font-weight:400; color:var(--cream); list-style:none; display:flex; justify-content:space-between; align-items:center; gap:1rem;"
              >Do you cover events in Houston and Sugar Land, not just Katy?<span
                style="color:var(--gold); font-size:1.2rem; flex-shrink:0;"
                >+</span
              ></summary
            >
            <p class="body-sm" style="margin-top:1rem; padding-right:2rem;">
              Absolutely. NiO Pictures is based in Katy TX but actively serves
              Houston, Sugar Land, and Richmond for all event types - corporate,
              private, and cultural.
            </p>
          </details>

          <details
            style="border-bottom:1px solid var(--border-light); padding: 1.5rem 0;"
          >
            <summary
              style="cursor:pointer; font-family:var(--font-display); font-size:1.15rem; font-weight:400; color:var(--cream); list-style:none; display:flex; justify-content:space-between; align-items:center; gap:1rem;"
              >What is included in event photography coverage?<span
                style="color:var(--gold); font-size:1.2rem; flex-shrink:0;"
                >+</span
              ></summary
            >
            <p class="body-sm" style="margin-top:1rem; padding-right:2rem;">
              Every package includes 2-hour event coverage, professionally
              edited images in my cinematic style, and delivery via a private
              online gallery. Additional coverage hours are available — contact
              me for custom quotes.
            </p>
          </details>

          <details style="padding: 1.5rem 0;">
            <summary
              style="cursor:pointer; font-family:var(--font-display); font-size:1.15rem; font-weight:400; color:var(--cream); list-style:none; display:flex; justify-content:space-between; align-items:center; gap:1rem;"
              >Are you available on weekends and weeknights?<span
                style="color:var(--gold); font-size:1.2rem; flex-shrink:0;"
                >+</span
              ></summary
            >
            <p class="body-sm" style="margin-top:1rem; padding-right:2rem;">
              Yes. NiO Pictures offers photography sessions on weekends and
              weeknight evenings throughout Katy, Houston, Sugar Land, and
              Richmond TX.
            </p>
          </details>
        </div>
      </div>
    </section>

    <section class="section" aria-label="Client testimonials">
      <div class="container">
        <div class="section-header center reveal">
          <p class="eyebrow">What Clients Say</p>
          <div class="gold-line center gold-line-animate"></div>
          <h2 class="display-md">Stories from Our Clients</h2>
        </div>

        <div class="testimonials-track">
          <article class="testimonial-card reveal reveal-delay-1">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-text">
              "We had a great experience with Palani at our housewarming party.
              We truly appreciate his work, he was very gentle, professional,
              and made everyone feel comfortable. The photos turned out beautiful
              and captured all the special moments perfectly. Highly recommend!"
            </p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">VK</div>
              <div>
                <div class="testimonial-name">Venkatesh K.</div>
                <div class="testimonial-role">Housewarming Party · Fulshear, TX</div>
              </div>
            </div>
          </article>

          <article class="testimonial-card reveal reveal-delay-2">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-text">
              "Palani from Nio Pictures covered photoshoot for our son's 8th
              grade graduation dance party. What an amazing experience he
              delivered to him and his friends. Patient, creative and very
              diligent is what the experience was. Super happy with all the
              pictures and would highly recommend Nio Pictures!"
            </p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">MS</div>
              <div>
                <div class="testimonial-name">Malav S.</div>
                <div class="testimonial-role">Graduation Dance Party · Katy, TX</div>
              </div>
            </div>
          </article>
        </div>

        <div class="testimonials-cta reveal" style="text-align: center; margin-top: 2rem;">
          <a
