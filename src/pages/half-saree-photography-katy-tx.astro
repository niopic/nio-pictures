---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
const title =
  "Half-Saree Ceremony Photography Katy TX | NiO Pictures";
const description =
  "Half-saree ceremony photography in Katy TX and the greater Houston area - capturing this coming-of-age milestone with cultural care and a cinematic eye.";
const canonical = "https://niopictures.com/half-saree-photography-katy-tx";
const ogImage = "https://niopictures.com/assets/images/og-home.webp";
const extraHead =
  '<script type="application/ld+json">\n  {\n    "@context": "https://schema.org",\n    "@type": "BreadcrumbList",\n    "itemListElement": [\n      {"@type":"ListItem","position":1,"name":"Home","item":"https://niopictures.com/"},\n      {"@type":"ListItem","position":2,"name":"Half-Saree Ceremony Photography Katy TX","item":"https://niopictures.com/half-saree-photography-katy-tx"}\n    ]\n  }\n  </script>\n<script type="application/ld+json">\n  {\n    "@context": "https://schema.org",\n    "@type": "FAQPage",\n    "mainEntity": [\n      {\n        "@type": "Question",\n        "name": "Do you photograph half-saree ceremonies?",\n        "acceptedAnswer": {\n          "@type": "Answer",\n          "text": "Yes. NiO Pictures regularly photographs half-saree ceremonies throughout Katy and the greater Houston area, including preparation, ceremony, and family portraits."\n        }\n      },\n      {\n        "@type": "Question",\n        "name": "Do you offer portrait sessions separate from event coverage for half-saree ceremonies?",\n        "acceptedAnswer": {\n          "@type": "Answer",\n          "text": "Yes. Many families book a dedicated portrait session in addition to ceremony coverage - this can be discussed during your consultation."\n        }\n      },\n      {\n        "@type": "Question",\n        "name": "How far in advance should I book half-saree ceremony photography?",\n        "acceptedAnswer": {\n          "@type": "Answer",\n          "text": "We recommend booking 4-6 weeks in advance when possible, especially during peak celebration season."\n        }\n      }\n    ]\n  }\n  </script>';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
>
  <Fragment slot="head" set:html={extraHead} />
  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'">Skip to main content</a
  >

  <Nav />

  <div
    style="padding: calc(var(--section-pad) + 4rem) 0 var(--section-pad); border-bottom: 1px solid var(--border-light);"
  >
    <div class="container">
      <div class="reveal">
        <p class="eyebrow" style="margin-bottom:1rem;">
          Half-Saree Ceremony Photography
        </p>
        <div class="gold-line gold-line-animate"></div>
        <h1 class="display-xl" style="max-width:700px; margin-bottom:1.25rem;">
          Half-Saree<br /><em style="font-style:italic; color:var(--gold);"
            >Ceremony</em
          >
        </h1>
        <p class="body-lg" style="max-width:580px; margin-bottom:2.5rem;">
          The half-saree ceremony (Langa Voni) marks a meaningful coming-of-age
          milestone, rich with tradition, family, and celebration. NiO Pictures
          photographs these ceremonies with cultural understanding and a
          cinematic eye, throughout Katy and the greater Houston area.
        </p>
        <div style="display:flex; gap:1rem; flex-wrap:wrap;">
          <a href="/contact" class="btn btn-primary btn-arrow"
            >Start a Conversation</a
          >
          <a href="/portfolio" class="btn btn-outline">See Portfolio</a>
        </div>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header center reveal">
        <p class="eyebrow">Half-Saree Ceremony Photography</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">A Coming-of-Age Milestone</h2>
      </div>
      <div class="features-grid reveal reveal-delay-1">
        <div class="feature-card">
          <div class="feature-icon">◇</div>
          <h3 class="feature-title">The Preparation</h3>
          <p class="body-sm">
            Getting ready, the saree draping, the jewelry and details that make
            the day feel different from any other.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◈</div>
          <h3 class="feature-title">The Ceremony</h3>
          <p class="body-sm">
            The blessings, the traditions, the family gathered around -
            photographed candidly as it unfolds.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◉</div>
          <h3 class="feature-title">Portraits</h3>
          <p class="body-sm">
            Individual and family portraits that capture this milestone the way
            it deserves to be remembered.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="section"
    style="background:var(--surface); border-top:1px solid var(--border-light); border-bottom:1px solid var(--border-light);"
  >
    <div class="container" style="max-width:800px;">
      <div class="section-header center reveal">
        <p class="eyebrow">Why NiO Pictures</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">Capture With Respect & Care</h2>
      </div>
      <p
        class="body-lg reveal"
        style="text-align:center; max-width:620px; margin:0 auto 2rem;"
      >
        A half-saree ceremony is deeply personal - it's a milestone in a young
        woman's life, surrounded by family tradition. NiO Pictures brings genuine
        care and cultural respect to every half-saree session, capturing both the
        formal moments and the candid ones in between.
      </p>
      <div
        style="display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;"
        class="reveal"
      >
        <a
          href="/event-photography-katy-tx"
          class="btn btn-gold-outline btn-arrow"
          >All South Asian Celebrations</a
        >
        <a href="/portfolio" class="btn btn-gold-outline btn-arrow"
          >See Portfolio</a
        >
        <a href="/about" class="btn btn-outline">About Palanivel</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:900px;">
      <div class="section-header center reveal">
        <p class="eyebrow">Half-Saree Ceremony Insight</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">
          Why This Milestone Deserves Thoughtful Photography
        </h2>
      </div>
      <p
        class="body-lg reveal"
        style="text-align:center; max-width:760px; margin:0 auto 1.25rem;"
      >
        The half-saree ceremony marks a significant moment in a young woman's
        life - a transition into womanhood, celebrated with family, tradition,
        and cultural pride.
      </p>
      <p
        class="body-lg reveal reveal-delay-1"
        style="text-align:center; max-width:760px; margin:0 auto 1.25rem;"
      >
        We approach each half-saree ceremony as a day to document with intention
        - the quiet moments of preparation, the beauty and significance of the
        ceremony itself, and the genuine joy of family gathered to celebrate a
        young woman stepping into a new chapter.
      </p>
      <p
        class="body-lg reveal reveal-delay-2"
        style="text-align:center; max-width:760px; margin:0 auto;"
      >
        This is the kind of milestone families return to us for, year after year
        - knowing that we understand the cultural importance and will capture it
        with both cinematic beauty and authentic respect.
      </p>
      <div
        style="display:flex; gap:1rem; flex-wrap:wrap; justify-content:center; margin-top:2rem;"
        class="reveal"
      >
        <a
          href="/event-photography-katy-tx"
          class="btn btn-gold-outline btn-arrow"
          >Half-Saree & Event Photography</a
        >
        <a href="/family-photography-katy-tx" class="btn btn-outline"
          >Family Photography Services</a
        >
      </div>
    </div>
  </section>

  <section class="cta-banner reveal">
    <div class="container">
      <p class="eyebrow" style="margin-bottom:1.25rem;">
        Half-Saree Ceremony Photography
      </p>
      <h2
        class="display-md"
        style="margin-bottom:1rem; max-width:520px; margin-left:auto; margin-right:auto;"
      >
        Capture This<br /><em style="font-style:italic; color:var(--gold);"
          >Milestone</em
        >
      </h2>
      <p class="body-lg" style="max-width:420px; margin:0 auto 2.5rem;">
        Half-saree ceremonies and coming-of-age celebrations throughout Katy and
        the greater Houston area.
      </p>
      <div
        style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;"
      >
        <a href="/contact" class="btn btn-primary btn-arrow"
          >Start a Conversation</a
        >
        <a href="/contact" class="btn btn-outline">Get in Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>
