---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { PACKAGES, formatTurnaroundFull, formatCoverageHours } from "../data/pricing";
import { halfSareeImages } from "../content/images.config";

const title =
  "Half-Saree Ceremony Photography Katy TX | NiO Pictures";
const description =
  "Half-saree ceremony photography in Katy TX and the greater Houston area - capturing this coming-of-age milestone with cultural care and a cinematic eye.";
const canonical = "https://niopictures.com/half-saree-photography-katy-tx";
const ogImage = "https://niopictures.com/assets/images/og-home.webp";

const heritageSession = PACKAGES.find(p => p.id === "heritage-session")!;
const heritageFilmTier = heritageSession.tiers.find(t => t.turnaround)!;

const extraHead = `<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type":"ListItem","position":1,"name":"Home","item":"https://niopictures.com/"},
      {"@type":"ListItem","position":2,"name":"Half-Saree Ceremony Photography Katy TX","item":"https://niopictures.com/half-saree-photography-katy-tx"}
    ]
  }
  </script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Do you photograph half-saree ceremonies?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. NiO Pictures regularly photographs half-saree ceremonies throughout Katy and the greater Houston area, including preparation, ceremony, and family portraits."
        }
      },
      {
        "@type": "Question",
        "name": "Do you offer portrait sessions separate from event coverage for half-saree ceremonies?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Many families book a dedicated portrait session in addition to ceremony coverage - this can be discussed during your consultation."
        }
      },
      {
        "@type": "Question",
        "name": "How far in advance should I book half-saree ceremony photography?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We recommend booking 4-6 weeks in advance when possible, especially during peak celebration season."
        }
      },
      {
        "@type": "Question",
        "name": "What's included in a half-saree ceremony photography package?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Coverage includes the full ceremony — from the traditional saree-draping moment through family blessings and celebrations afterward — for up to ${formatCoverageHours(heritageSession.coverageHours)}. You'll receive 150+ edited photos within ${formatTurnaroundFull(heritageSession.photoTurnaround)}, with the option to add ${heritageFilmTier.proseLabel ?? heritageFilmTier.label}, delivered in about ${formatTurnaroundFull(heritageFilmTier.turnaround!)}."
        }
      },
      {
        "@type": "Question",
        "name": "What rituals are typically photographed at a half-saree ceremony?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Coverage typically includes haldi (turmeric application), the water-pouring ritual, mehndi (henna) application, blessings from family elders, and the reception celebration — whether that spans one location or two, such as a home ceremony followed by a venue celebration."
        }
      }
    ]
  }
  </script>`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
>
  <Fragment slot="head" set:html={extraHead} />
  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'">Skip to main content</a
  >

  <Nav />

  <div class="page-hero" style="margin-top: 0; padding-top: 0;">
    <div class="page-hero-bg" style="background-color: #18161a;">
      <Image
        src={halfSareeImages.pageHero.img}
        alt={halfSareeImages.pageHero.alt}
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1200, 1600, 1920]}
        sizes="100vw"
        quality={90}
        class="page-hero-bg-image"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content container">
      <p class="eyebrow" style="margin-bottom:1rem;">
        Half-Saree Ceremony Photography
      </p>
      <h1 class="display-xl" style="max-width:700px; margin-bottom:1.25rem;">
        Half-Saree<br /><em style="font-style:italic; color:var(--gold);"
          >Ceremony</em
        >
      </h1>
      <p class="body-lg" style="max-width:580px; margin-bottom:2.5rem;">
        Half-saree ceremony photography Katy TX for the Langa Voni
        milestone, the blessing, and every moment in between.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header center reveal">
        <p class="eyebrow">Half-Saree Ceremony Photography</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">A Coming-of-Age Milestone</h2>
      </div>
      <div class="features-grid reveal reveal-delay-1">
        <div class="feature-card">
          <div class="feature-icon">◇</div>
          <h3 class="feature-title">The Preparation</h3>
          <p class="body-sm">
            Getting ready, the saree draping, the mehndi application - the quiet,
            detail-rich moments before the ceremony begins.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◈</div>
          <h3 class="feature-title">The Ceremony</h3>
          <p class="body-sm">
            Haldi, the water-pouring ritual, blessings from family elders -
            traditions captured candidly as they unfold, from backyard to
            banquet hall.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◉</div>
          <h3 class="feature-title">Portraits</h3>
          <p class="body-sm">
            Individual and family portraits, including grandparents and
            siblings, that capture this milestone the way it deserves to be
            remembered.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="section"
    style="background:var(--surface); border-top:1px solid var(--border-light); border-bottom:1px solid var(--border-light);"
  >
    <div class="container" style="max-width:800px;">
      <div class="section-header center reveal">
        <p class="eyebrow">Why NiO Pictures</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">Capture With Respect & Care</h2>
      </div>
      <p
        class="body-lg reveal"
        style="text-align:center; max-width:620px; margin:0 auto 2rem;"
      >
        A half-saree ceremony is deeply personal - it's a milestone in a young
        woman's life, surrounded by family tradition. NiO Pictures brings genuine
        care and cultural respect to every half-saree session, capturing both the
        formal moments and the candid ones in between.
      </p>
      <div
        style="display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;"
        class="reveal"
      >
        <a
          href="/event-photography-katy-tx"
          class="btn btn-gold-outline btn-arrow"
          >All South Asian Celebrations</a
        >
        <a href="/portfolio" class="btn btn-gold-outline btn-arrow"
          >See Portfolio</a
        >
        <a href="/about" class="btn btn-outline">About Palanivel</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header center reveal">
        <p class="eyebrow">Half-Saree Gallery</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">From Recent Ceremonies</h2>
      </div>

      <div class="featured-grid reveal reveal-delay-1">
        <div class="grid-item">
          <Image
            src={halfSareeImages.gridSlot1.img}
            alt={halfSareeImages.gridSlot1.alt}
            loading="lazy"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            width={800}
            height={600}
            style="background:var(--surface-2)"
          />
        </div>
        <div class="grid-item">
          <Image
            src={halfSareeImages.gridSlot2.img}
            alt={halfSareeImages.gridSlot2.alt}
            loading="lazy"
            widths={[300, 400, 800]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            width={400}
            height={533}
            style="background:var(--surface-2)"
          />
        </div>
        <div class="grid-item">
          <Image
            src={halfSareeImages.gridSlot3.img}
            alt={halfSareeImages.gridSlot3.alt}
            loading="lazy"
            widths={[300, 400, 800]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            width={400}
            height={533}
            style="background:var(--surface-2)"
          />
        </div>
        <div class="grid-item">
          <Image
            src={halfSareeImages.gridSlot4.img}
            alt={halfSareeImages.gridSlot4.alt}
            loading="lazy"
            widths={[300, 400, 800]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            width={400}
            height={533}
            style="background:var(--surface-2)"
          />
        </div>
        <div class="grid-item">
          <Image
            src={halfSareeImages.gridSlot5.img}
            alt={halfSareeImages.gridSlot5.alt}
            loading="lazy"
            widths={[300, 400, 800]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            width={400}
            height={533}
            style="background:var(--surface-2)"
          />
        </div>
        <div class="grid-item">
          <Image
            src={halfSareeImages.gridSlot6.img}
            alt={halfSareeImages.gridSlot6.alt}
            loading="lazy"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            width={800}
            height={533}
            style="background:var(--surface-2)"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section spotlight-section">
    <div class="container">
      <div class="spotlight-grid reveal">
        <div class="spotlight-image">
          <Image
            src={halfSareeImages.spotlightPortrait.img}
            alt={halfSareeImages.spotlightPortrait.alt}
            loading="lazy"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            width={800}
            height={1200}
            style="background:var(--surface-2)"
          />
        </div>
        <div class="spotlight-quote">
          <p class="eyebrow" style="margin-bottom:1rem;">A Recent Half-Saree Ceremony</p>
          <div class="gold-line gold-line-animate" style="margin-bottom:1.5rem;"></div>
          <div class="testimonial-stars" style="margin-bottom:1rem;">★★★★★</div>
          <p class="body-lg" style="margin-bottom:1.5rem;">
            "We had an absolutely wonderful experience with Palani at NiO
            Pictures for our daughter's half saree ceremony... He covered
            both days of our celebration&mdash;first at our home and
            backyard, and then at our party hall&mdash;capturing every
            special moment beautifully with professionalism, creativity,
            and an incredible eye for detail... If you're looking for a
            photographer who is talented, dependable, accommodating,
            reasonably priced, and delivers exceptional quality, we
            wholeheartedly recommend Palani and NiO Pictures."
          </p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">ST</div>
            <div>
              <div class="testimonial-name">Sunny T.</div>
              <div class="testimonial-role">Half-Saree Ceremony &middot; Houston, TX</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .spotlight-grid {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
      align-items: center;
    }
    .spotlight-image {
      border-radius: 2px;
      overflow: hidden;
    }
    .spotlight-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    @media (max-width: 860px) {
      .spotlight-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .spotlight-image {
        max-width: 420px;
        margin: 0 auto;
      }
    }
  </style>

  <section class="section">
    <div class="container" style="max-width:900px;">
      <div class="section-header center reveal">
        <p class="eyebrow">Half-Saree Ceremony Insight</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">
          Why This Milestone Deserves Thoughtful Photography
        </h2>
      </div>
      <p
        class="body-lg reveal"
        style="text-align:center; max-width:760px; margin:0 auto 1.25rem;"
      >
        The half-saree ceremony marks a significant moment in a young woman's
        life - a transition into womanhood, celebrated with family, tradition,
        and cultural pride. Whether your family calls it Langa Voni, Ritu
        Kala Samskara, or something else entirely, the heart of the
        celebration is the same.
      </p>
      <p
        class="body-lg reveal reveal-delay-1"
        style="text-align:center; max-width:760px; margin:0 auto 1.25rem;"
      >
        We approach each half-saree ceremony as a day to document with intention
        - the quiet moments of preparation, the beauty and significance of the
        ceremony itself, and the genuine joy of family gathered to celebrate a
        young woman stepping into a new chapter.
      </p>
      <p
        class="body-lg reveal reveal-delay-2"
        style="text-align:center; max-width:760px; margin:0 auto;"
      >
        This is the kind of milestone families return to us for, year after year
        - knowing that we understand the cultural importance and will capture it
        with both cinematic beauty and authentic respect.
      </p>
      <div
        style="display:flex; gap:1rem; flex-wrap:wrap; justify-content:center; margin-top:2rem;"
        class="reveal"
      >
        <a
          href="/event-photography-katy-tx"
          class="btn btn-gold-outline btn-arrow"
          >Half-Saree & Event Photography</a
        >
        <a href="/family-photography-katy-tx" class="btn btn-outline"
          >Family Photography Services</a
        >
      </div>
    </div>
  </section>

  <section class="cta-banner reveal">
    <div class="container">
      <p class="eyebrow" style="margin-bottom:1.25rem;">
        Half-Saree Ceremony Photography
      </p>
      <h2
        class="display-md"
        style="margin-bottom:1rem; max-width:520px; margin-left:auto; margin-right:auto;"
      >
        Capture This<br /><em style="font-style:italic; color:var(--gold);"
          >Milestone</em
        >
      </h2>
      <p class="body-lg" style="max-width:420px; margin:0 auto 2.5rem;">
        Half-saree ceremonies and coming-of-age celebrations throughout Katy and
        the greater Houston area.
      </p>
      <div
        style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;"
      >
        <a href="/contact" class="btn btn-primary btn-arrow"
          >Start a Conversation</a
        >
        <a href="/contact" class="btn btn-outline">Get in Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>
