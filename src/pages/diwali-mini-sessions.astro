---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { DIWALI_MINI, formatUSD } from "../data/pricing";
import { diwaliMiniImages } from "../content/images.config";

const title =
  "Diwali Mini Sessions Katy TX | Festival Portrait Photography | NiO Pictures";
const description =
  "Diwali Mini Sessions in Katy TX — a 30-minute festive portrait session, 15 edited images. For a limited time only.";
const canonical = "https://niopictures.com/diwali-mini-sessions";
const ogImage = "https://niopictures.com/assets/images/og-home.webp";

// Pixieset self-booking — always secondary, matches Nav.astro's SELF_BOOK_URL.
const SELF_BOOK_URL = "https://niopictures.pixieset.com/booking/";

const extraHead = `<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type":"ListItem","position":1,"name":"Home","item":"https://niopictures.com/"},
      {"@type":"ListItem","position":2,"name":"Diwali Mini Sessions","item":"https://niopictures.com/diwali-mini-sessions"}
    ]
  }
  </script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What's included in a Diwali Mini Session?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A Diwali Mini Session includes ${DIWALI_MINI.deliverables.join(", ")}."
        }
      },
      {
        "@type": "Question",
        "name": "How long does a Diwali Mini Session run?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Diwali Mini Sessions run ${DIWALI_MINI.coverageMinutes} minutes and are priced at ${formatUSD(DIWALI_MINI.price)}."
        }
      },
      {
        "@type": "Question",
        "name": "How is this different from NiO Pictures' regular photography packages?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Diwali Mini Sessions are a standalone offer - a single ${DIWALI_MINI.coverageMinutes}-minute studio session priced separately from our full event and family packages. ${DIWALI_MINI.bookingNote}"
        }
      },
      {
        "@type": "Question",
        "name": "How do I book a Diwali Mini Session?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Start a conversation through our contact page to check current availability, or reserve directly through our online booking. ${DIWALI_MINI.bookingNote} ${DIWALI_MINI.locationNote}"
        }
      }
    ]
  }
  </script>`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
>
  <Fragment slot="head" set:html={extraHead} />
  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'"
  >
    Skip to main content
  </a>

  <Nav />

  <div class="page-hero" style="margin-top: 0; padding-top: 0;">
    <div class="page-hero-bg" style="background-color: #18161a;">
      <Image
        src={diwaliMiniImages.pageHero.img}
        alt={diwaliMiniImages.pageHero.alt}
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1200, 1600, 1920]}
        sizes="100vw"
        quality={90}
        class="page-hero-bg-image"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content container">
      <p class="eyebrow" style="margin-bottom:1rem;">
        Festival Portrait Photography
      </p>
      <h1 class="display-xl" style="max-width:700px; margin-bottom:1.25rem;">
        Diwali Mini
        <br />
        <em style="font-style:italic; color:var(--gold);">Sessions</em>
      </h1>
      <p class="body-lg" style="max-width:580px; margin-bottom:2.5rem;">
        {DIWALI_MINI.bookingNote}
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header center reveal">
        <p class="eyebrow">The Details</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">A Festive Session, Simplified</h2>
      </div>
      <div class="features-grid reveal reveal-delay-1">
        <div class="feature-card">
          <div class="feature-icon">◇</div>
          <h3 class="feature-title">{formatUSD(DIWALI_MINI.price)}</h3>
          <p class="body-sm">{DIWALI_MINI.tagline}</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◈</div>
          <h3 class="feature-title">What You Get</h3>
          <p class="body-sm">{DIWALI_MINI.deliverables.join(" · ")}</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◉</div>
          <h3 class="feature-title">{DIWALI_MINI.bookingNote}</h3>
          <p class="body-sm">{DIWALI_MINI.locationNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header center reveal">
        <p class="eyebrow">Diwali Mini Sessions</p>
        <div class="gold-line center gold-line-animate"></div>
        <h2 class="display-md">From Recent Diwali Sessions</h2>
      </div>

      <div class="featured-grid reveal reveal-delay-1">
        <div class="grid-item">
          <Image
            src={diwaliMiniImages.gridSlot1.img}
            alt={diwaliMiniImages.gridSlot1.alt}
            loading="lazy"
            widths={[300, 400, 800]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            width={400}
            height={533}
            style="background:var(--surface-2)"
          />
        </div>
        <div class="grid-item">
          <Image
            src={diwaliMiniImages.gridSlot2.img}
            alt={diwaliMiniImages.gridSlot2.alt}
            loading="lazy"
            widths={[300, 400, 800]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            width={400}
            height={533}
            style="background:var(--surface-2)"
          />
        </div>
        <div class="grid-item">
          <Image
            src={diwaliMiniImages.gridSlot3.img}
            alt={diwaliMiniImages.gridSlot3.alt}
            loading="lazy"
            widths={[300, 400, 800]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            width={400}
            height={533}
            style="background:var(--surface-2)"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="cta-banner reveal">
    <div class="container">
      <p class="eyebrow" style="margin-bottom:1.25rem;">
        Diwali Mini Sessions
      </p>
      <h2
        class="display-md"
        style="margin-bottom:1rem; max-width:520px; margin-left:auto; margin-right:auto;"
      >
        Reserve Your
        <br />
        <em style="font-style:italic; color:var(--gold);">Diwali Slot</em>
      </h2>
      <p class="body-lg" style="max-width:420px; margin:0 auto 2.5rem;">
        {formatUSD(DIWALI_MINI.price)} · {DIWALI_MINI.bookingNote}
      </p>
      <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
        <a href="/contact" class="btn btn-primary btn-arrow">
          Book Your Diwali Mini Session
        </a>
        <a
          href={SELF_BOOK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          Book via Pixieset
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .featured-grid .grid-item:nth-child(1) {
    aspect-ratio: 3 / 4;
  }
  @media (max-width: 768px) {
    .featured-grid .grid-item:nth-child(1) {
      aspect-ratio: 3 / 4;
    }
  }
  @media (max-width: 480px) {
    .featured-grid .grid-item:nth-child(1) {
      aspect-ratio: 3 / 4;
    }
  }
</style>
