---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import PricingSection from "../components/PricingSection.astro";

import heroHomeImage from "../assets/images/hero-home.webp";
import { homeImages, momentStories } from "../content/images.config";
import { buildOfferCatalog, formatUSD, PACKAGES, packageFrom } from "../data/pricing";

const siteUrl = "https://niopictures.com";
const homeHeroImageUrl = `${siteUrl}${heroHomeImage.src}`;
const homeHeroImageLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ImageObject",
  name: "NiO Pictures home hero image",
  description:
    "Cinematic event and family photography in Katy, Texas by NiO Pictures.",
  contentUrl: homeHeroImageUrl,
  url: homeHeroImageUrl,
  creditText: "NiO Pictures",
  creator: {
    "@type": "Person",
    name: "Palanivel",
  },
  license: "https://niopictures.com/terms",
  acquireLicensePage: "https://niopictures.com/contact",
});

const familyFrom = formatUSD(packageFrom(PACKAGES.find((p) => p.id === "legacy-collection")!));
const eventFrom = formatUSD(packageFrom(PACKAGES.find((p) => p.id === "heritage-session")!));

const filmShowcaseLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: "Pongal Celebration — Tamil Sangam",
  description:
    "A glimpse of our cinematic highlight films, captured for a Pongal celebration with Tamil Sangam.",
  thumbnailUrl: "https://img.youtube.com/vi/PFTdwktgg2E/maxresdefault.jpg",
  embedUrl: "https://www.youtube.com/embed/PFTdwktgg2E",
  contentUrl: "https://youtu.be/PFTdwktgg2E",
  // TODO: add precise `duration` (ISO 8601, e.g. "PT2M14S") once confirmed
  // TODO: add accurate `uploadDate` (ISO 8601) once confirmed — do not guess
  publisher: {
    "@type": "Organization",
    name: "NiO Pictures",
    logo: {
      "@type": "ImageObject",
      url: "https://niopictures.com/assets/images/og-home.webp",
    },
  },
});

const businessSchemaLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService", "PhotographyStudio"],
  "@id": "https://niopictures.com/#business",
  name: "NiO Pictures",
  alternateName: "NiO Pictures Photography",
  description:
    "Premium solo hybrid photography for South Asian cultural milestone events, elegant family portraits, and cinematic photo + film storytelling in Katy, Houston, Cypress, Sugar Land, and Richmond, Texas.",
  url: "https://niopictures.com/",
  telephone: "+12814093585",
  email: "niopictureskaty@gmail.com",
  founder: { "@type": "Person", name: "Palanivel" },
  priceRange: "$$$",
  paymentAccepted: "Cash, Credit Card, Venmo",
  currenciesAccepted: "USD",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Katy",
    addressRegion: "TX",
    postalCode: "77449",
    addressCountry: "US",
  },
  geo: { "@type": "GeoCoordinates", latitude: "29.7858", longitude: "-95.8245" },
  areaServed: [
    { "@type": "City", name: "Katy", sameAs: "https://en.wikipedia.org/wiki/Katy,_Texas" },
    { "@type": "City", name: "Cypress" },
    { "@type": "City", name: "Houston", sameAs: "https://en.wikipedia.org/wiki/Houston" },
    { "@type": "City", name: "Sugar Land", sameAs: "https://en.wikipedia.org/wiki/Sugar_Land,_Texas" },
    { "@type": "City", name: "Richmond", sameAs: "https://en.wikipedia.org/wiki/Richmond,_Texas" },
  ],
  keywords: [
    "premium family photography",
    "event photographer",
    "South Asian celebration photography",
    "hybrid photo and film",
    "Katy TX photographer",
  ],
  image: "https://niopictures.com/assets/images/og-home.webp",
  sameAs: [
    "https://www.instagram.com/nio_pictures",
    "https://www.facebook.com/profile.php?id=61580596898855",
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5.0",
    reviewCount: "16",
    bestRating: "5",
    worstRating: "1",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday", "Sunday"],
      opens: "09:00",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "18:00",
      closes: "21:00",
    },
  ],
  hasOfferCatalog: buildOfferCatalog(),
});
---

<BaseLayout
  title="NiO Pictures | Event & Family Photographer in Katy TX | Houston Area"
  description="NiO Pictures — Katy TX event & family photographer. Cinematic corporate events, Indian celebrations, and heirloom portraits. Serving Katy, Cypress, Houston, Sugar Land & Richmond."
  canonical="https://niopictures.com/"
  ogImage="https://niopictures.com/assets/images/og-home.webp"
  deferComponentsCss={true}
>
  <fragment slot="head">
    <style is:inline>
      :root {
        --black: #161412;
        --gold: #c5a572;
        --cream: #f0e8d8;
        --muted: #a89880;
        --border: rgba(197, 165, 114, 0.15);
        --border-light: rgba(197, 165, 114, 0.08);
        --font-display: "Cormorant Garamond", Georgia, serif;
        --font-body: system-ui, sans-serif;
        --font-accent: "Cinzel", Georgia, serif;
        --container: 1200px;
        --gutter: clamp(1.25rem, 5vw, 2.5rem);
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      body {
        background: var(--black);
        color: var(--cream);
        font-family: var(--font-body);
        font-weight: 300;
        line-height: 1.7;
        overflow-x: hidden;
      }
      a {
        text-decoration: none;
        color: inherit;
      }
      .container {
        width: 100%;
        max-width: var(--container);
        margin: 0 auto;
        padding: 0 var(--gutter);
      }
      .display-xl {
        font-family: var(--font-display);
        font-size: clamp(2.8rem, 7vw, 5.5rem);
        font-weight: 300;
        line-height: 1.08;
        letter-spacing: -0.01em;
      }
      .eyebrow {
        font-family: var(--font-accent);
        font-size: clamp(0.65rem, 1.2vw, 0.75rem);
        font-weight: 400;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--gold);
      }
      .body-sm {
        font-size: 0.875rem;
        font-weight: 300;
        line-height: 1.7;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-accent);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 0.9rem 2rem;
        border: 1px solid transparent;
        border-radius: 2px;
        position: relative;
        overflow: hidden;
      }
      .btn-primary {
        background: var(--gold);
        color: var(--black);
        border-color: var(--gold);
      }
      .btn-outline {
        background: transparent;
        color: var(--cream);
        border-color: var(--cream-border);
      }
      .btn-gold-outline {
        background: transparent;
        color: var(--gold);
        border-color: var(--gold);
      }
      .btn-arrow::after {
        content: "→";
        font-family: var(--font-body);
        font-size: 0.85rem;
      }
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        padding: 1.5rem var(--gutter);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .nav::before {
        content: "";
        position: absolute;
        inset: 0;
        background: transparent;
        border-bottom: 1px solid transparent;
        pointer-events: none;
      }
      .nav-logo {
        font-family: var(--font-accent);
        font-size: 1.1rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        color: var(--cream);
        text-transform: uppercase;
        position: relative;
        z-index: 1;
      }
      .nav-logo span {
        color: var(--gold);
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 2.5rem;
        position: relative;
        z-index: 1;
      }
      .nav-links a {
        font-family: var(--font-accent);
        font-size: 0.65rem;
        font-weight: 400;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        position: relative;
        -webkit-tap-highlight-color: transparent;
      }
      .nav-links a.active,
      .nav-links a:hover {
        color: var(--cream);
      }
      .nav-cta {
        position: relative;
        z-index: 1;
      }
      .nav-toggle,
      .nav-mobile {
        display: none;
      }
      .hero {
        position: relative;
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      .hero-bg {
        position: absolute;
        inset: 0;
        background-color: #1e1a17;
        background-image: none;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        overflow: hidden;
      }
      .hero-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        filter: saturate(1.02) contrast(1.02);
      }
      .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          160deg,
          rgba(22, 20, 18, 0.72) 0%,
          rgba(22, 20, 18, 0.55) 40%,
          rgba(22, 20, 18, 0.75) 100%
        );
      }
      .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 860px;
        padding: clamp(5.5rem, 11vh, 7.5rem) var(--gutter)
          clamp(5rem, 10vh, 6rem);
      }
      .hero-content .eyebrow {
        margin-bottom: 1.35rem;
      }
      .hero-title em,
      .display-xl em {
        font-style: italic;
        color: var(--gold);
      }
      .hero-subtitle {
        font-size: clamp(0.95rem, 1.8vw, 1.08rem);
        font-weight: 300;
        color: var(--muted);
        max-width: 560px;
        margin: 0 auto 1.75rem;
        line-height: 1.8;
      }
      .hero-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.85rem;
        flex-wrap: wrap;
        margin-top: 1.25rem;
        margin-bottom: 2rem;
        position: relative;
        z-index: 3;
      }
      .hero-scroll {
        position: absolute;
        bottom: 2.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
      }
      .hero-scroll span {
        font-family: var(--font-accent);
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .scroll-line {
        width: 1px;
        height: 40px;
        background: linear-gradient(to bottom, var(--gold), transparent);
      }
      .hybrid-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: clamp(2rem, 5vw, 3rem);
        align-items: start;
        max-width: 1180px;
        margin: 0 auto;
      }
      .hybrid-card {
        border: 1px solid var(--border-light);
        background: linear-gradient(
          180deg,
          rgba(22, 20, 18, 0.96),
          rgba(14, 13, 12, 0.98)
        );
        border-radius: 2px;
        padding: 1.2rem 1.15rem;
        box-shadow: 0 18px 30px rgba(0, 0, 0, 0.16);
      }
      .hybrid-card + .hybrid-card {
        margin-top: 1rem;
      }
      .hybrid-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-family: var(--font-accent);
        font-size: 0.62rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 0.75rem;
      }
      @media (max-width: 768px) {
        .nav-links,
        .nav-cta {
          display: none;
        }
        .nav-toggle {
          display: flex;
          flex-direction: column;
          gap: 5px;
          padding: 4px;
          position: relative;
          z-index: 1;
        }
        .nav-toggle span {
          display: block;
          width: 24px;
          height: 1px;
          background: var(--cream);
        }
        .display-xl {
          font-size: clamp(2.2rem, 8vw, 2.8rem);
        }
        .hybrid-grid {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 480px) {
        .hero-actions {
          flex-direction: column;
          align-items: center;
        }
        .display-xl {
          font-size: 2rem;
        }
      }
      .feature-card-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        max-width: 920px;
        margin: 0 auto;
      }
      @media (max-width: 768px) {
        .feature-card-group {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
      }
      @media (max-width: 480px) {
        .feature-card-group {
          gap: 1.5rem;
        }
      }
    </style>
    <link
      rel="preload"
      as="image"
      href={heroHomeImage.src}
      fetchpriority="high"
    />
    <script type="application/ld+json" is:inline set:html={homeHeroImageLd} />
    <script type="application/ld+json" is:inline set:html={businessSchemaLd} />
    <script type="application/ld+json" is:inline set:html={filmShowcaseLd} />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://niopictures.com/"
          }
        ]
      }
    </script>
  </fragment>

  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'">Skip to main content</a
  >

  <Nav />

  <main id="main-content">
    <section class="hero" aria-label="Hero">
      <div class="hero-bg" data-fetchpriority="high">
        <Image
          src={heroHomeImage}
          alt="Cinematic hybrid photo + film coverage for South Asian celebrations in Katy, Sugar Land, and Cypress"
          class="hero-image"
          width={1600}
          height={1100}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 768px) 100vw, 100vw"
          loading="eager"
          decoding="async"
          priority
          fetchpriority="high"
          quality={82}
        />
      </div>
      <div class="hero-overlay"></div>

      <div class="hero-content">
        <p class="eyebrow">Photography for South Asian milestones</p>
        <h1 class="display-xl">
          Photography &amp; Film for South Asian Milestones
        </h1>
        <p
          class="body-sm"
          style="max-width: 420px; margin: 0.8rem auto 0; color: var(--muted); letter-spacing: 0.02em;"
        >
          Katy, Texas · Houston · Sugar Land · Richmond
        </p>
        <p class="hero-subtitle">
          Half-saree ceremonies, housewarmings, milestone birthdays, and the
          family moments worth keeping forever — photographed with a calm,
          cinematic touch in Katy, Sugar Land &amp; Cypress.
        </p>
        <p
          class="body-sm"
          style="max-width: 640px; margin: 0.75rem auto 0; color: var(--cream);"
        >
          The kind of images that feel like home — full of blessings, laughter,
          and the small details you’ll want to revisit for years.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary btn-arrow"
            >Start a Conversation</a
          >
          <a href="#hybrid" class="btn btn-gold-outline btn-arrow"
            >View Hybrid Coverage</a
          >
          <a href="/portfolio" class="btn btn-outline">View Portfolio</a>
        </div>
      </div>

      <div
        class="hero-scroll"
        role="button"
        aria-label="Scroll down"
        tabindex="0"
      >
        <div class="scroll-line"></div>
        <span>Scroll</span>
      </div>
    </section>


    <div
      style="background: var(--surface); border-bottom: 1px solid var(--border-light); padding: 0.9rem 0; text-align: center;"
    >
      <div
        class="container"
        style="display:flex; align-items:center; justify-content:center; gap: 2rem; flex-wrap: wrap;"
      >
        <span class="location-badge"><span>★</span> 5★ Rated Reviews</span>
        <span class="location-badge"><span>✦</span> Since 2017</span>
        <span class="location-badge"><span>✦</span> Katy, TX</span>
        <span class="location-badge"><span>✦</span> Cypress</span>
        <span class="location-badge"><span>✦</span> Houston</span>
        <span class="location-badge"><span>✦</span> Sugar Land</span>
        <span class="location-badge"><span>✦</span> Richmond, TX</span>
      </div>
      <address
        style="display:none;"
        itemscope
        itemtype="https://schema.org/LocalBusiness"
      >
        <span itemprop="name">NiO Pictures</span>
        <span itemprop="addressLocality">Katy</span>,
        <span itemprop="addressRegion">TX</span>
        <a href="tel:+12814093585" itemprop="telephone">281-409-3585</a>
        <a href="mailto:niopictureskaty@gmail.com" itemprop="email"
          >niopictureskaty@gmail.com</a
        >
      </address>
    </div>

    <div class="service-split" role="region" aria-label="Photography services">
      <a href="/event-photography-katy-tx" class="service-panel">
        <div
          class="service-panel-bg"
          style={`background-image: url('${homeImages.servicePanelEvents.img.src}'); background-color: #1a1816;`}
        >
        </div>
        <div class="service-panel-overlay"></div>
        <div class="service-panel-content">
          <p class="eyebrow">South Asian · Private · Corporate</p>
          <h2 class="service-panel-title">Event<br />Photography</h2>
          <p class="service-panel-desc" aria-hidden="true">
            From housewarmings and half-saree ceremonies to milestone celebrations of every kind,
            each frame is shaped to feel cinematic, warm, and deeply personal.
          </p>
          <span
            class="btn btn-gold-outline btn-arrow"
            style="pointer-events:none;">Explore Events</span
          >
        </div>
      </a>

      <a href="/family-photography-katy-tx" class="service-panel">
        <div
          class="service-panel-bg"
          style={`background-image: url('${homeImages.servicePanelFamily.img.src}'); background-color: #1c1915;`}
        >
        </div>
        <div class="service-panel-overlay"></div>
        <div class="service-panel-content">
          <p class="eyebrow">Portraits · Lifestyle · Legacy</p>
          <h2 class="service-panel-title">Family<br />Heirloom</h2>
          <p class="service-panel-desc" aria-hidden="true">
            Thoughtful portraits and family moments, designed to feel timeless,
            intimate, and worthy of being passed down with love.
          </p>
          <span
            class="btn btn-gold-outline btn-arrow"
            style="pointer-events:none;">Explore Family</span
          >
        </div>
      </a>
    </div>

    <p class="body-sm" style="text-align:center; padding: 1.25rem var(--gutter) 0; color: var(--muted);">
      Also available: <a href="/event-photography-katy-tx" style="color: var(--gold);">Corporate &amp; Brand Photography →</a>
    </p>

    <section class="section" id="hybrid" aria-label="Hybrid photo and film">
      <div class="container">
        <div class="hybrid-grid reveal">
          <div>
            <p class="eyebrow">Hybrid Photo + Film</p>
            <h2 class="display-md" style="margin-bottom: 1rem;">
              A fuller way to remember your celebration.
            </h2>
            <p
              class="body-lg"
              style="color: var(--muted); margin-bottom: 1rem;"
            >
              With one calm, intentional photographer, you get both heirloom
              stills and a short cinematic film — the emotion, ritual, and
              movement of the day, captured with warmth and care.
            </p>
            <p class="body-sm" style="color: var(--cream); max-width: 34rem;">
              Ideal for sangeet, receptions, baby blessings, griha pravesham,
              milestone birthdays, and cultural celebrations that deserve to be
              remembered with both beauty and feeling.
            </p>
          </div>
          <div>
            <article class="hybrid-card">
              <p class="hybrid-pill">✦ Heirloom stills + film</p>
              <h3
                style="font-family: var(--font-display); font-size: 1.15rem; color: var(--cream); margin-bottom: 0.35rem;"
              >
                Heirloom portraits, cinematic memory
              </h3>
              <p class="body-sm" style="color: var(--muted);">
                Beautiful stills for your home and a short film that lets the
                laughter, ritual, and emotion of the day live on long after the
                celebration ends.
              </p>
            </article>
            <article class="hybrid-card">
              <p class="hybrid-pill">✦ One calm creative point of view</p>
              <h3
                style="font-family: var(--font-display); font-size: 1.15rem; color: var(--cream); margin-bottom: 0.35rem;"
              >
                One calm creative presence
              </h3>
              <p class="body-sm" style="color: var(--muted);">
                With one solo hybrid photographer, your day feels simpler,
                smoother, and more intentional — from the first look to the
                final film frame.
              </p>
            </article>
            <article class="hybrid-card">
              <p class="hybrid-pill">✦ Designed for milestone days</p>
              <h3
                style="font-family: var(--font-display); font-size: 1.15rem; color: var(--cream); margin-bottom: 0.35rem;"
              >
                Designed for milestone moments
              </h3>
              <p class="body-sm" style="color: var(--muted);">
                Perfect for sangeet, receptions, baby blessings, and family
                gatherings that deserve both refined visuals and a deeply
                personal story.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <PricingSection />

    <!-- PLACEHOLDER FILM: swap PFTdwktgg2E for the 40th birthday highlight film once delivered -->
    <section class="section" aria-label="Film showcase" style="background: var(--surface); border-top: 1px solid var(--border-light);">
      <div class="container">
        <div class="section-header center reveal">
          <p class="eyebrow">Hybrid Photo + Film</p>
          <div class="gold-line center gold-line-animate"></div>
          <h2 class="display-md">A Glimpse of Our Cinematic Highlight Films</h2>
        </div>

        <div class="film-showcase reveal reveal-delay-1" style="max-width: 860px; margin: 2.5rem auto 0;">
          <div
            class="film-poster"
            role="button"
            tabindex="0"
            aria-label="Play highlight film: Pongal Celebration, Tamil Sangam"
            data-video-id="PFTdwktgg2E"
