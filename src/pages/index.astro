    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://niopictures.com/"
          }
        ]
      }
    </script>
  </fragment>

  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'">Skip to main content</a
  >

  <nav class="nav" role="navigation" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label="NiO Pictures Home">
      Ni<span>O</span> Pictures
    </a>

    <div class="nav-links">
      <a href="/event-photography-katy-tx">Events</a>
      <a href="/family-photography-katy-tx">Family</a>
      <a href="/portfolio">Portfolio</a>
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
    </div>

    <a
      href="https://niopictures.pixieset.com/booking/"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary nav-cta">Book Now</a
    >

    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <div class="nav-mobile" role="dialog" aria-label="Mobile navigation">
    <a href="/event-photography-katy-tx">Events</a>
    <a href="/family-photography-katy-tx">Family</a>
    <a href="/portfolio">Portfolio</a>
    <a href="/about">About</a>
    <a href="/blog">Blog</a>
    <a href="/contact">Contact</a>
    <a
      href="https://niopictures.pixieset.com/booking/"
      target="_blank"
      rel="noopener noreferrer"
      class="nav-mobile-cta">Book a Session</a
    >
  </div>

  <main id="main-content">
    <section class="hero" aria-label="Hero">
      <div class="hero-bg" data-fetchpriority="high">
        <Image
          src={heroHomeImage}
          alt="Cinematic hybrid photo + film coverage for South Asian celebrations in Katy, Sugar Land, and Cypress"
          class="hero-image"
          width={1600}
          height={1100}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 768px) 100vw, 100vw"
          loading="eager"
          decoding="async"
          priority
          fetchpriority="high"
          quality={82}
        />
      </div>
      <div class="hero-overlay"></div>

      <div class="hero-content">
        <p class="eyebrow">Photography for South Asian milestones</p>
        <h1 class="display-xl">
          Gentle, cinematic portraits and celebration photography in Katy, Sugar
          Land &amp; Cypress.
        </h1>
        <p
          class="body-sm"
          style="max-width: 420px; margin: 0.8rem auto 0; color: var(--muted); letter-spacing: 0.02em;"
        >
          Katy, Texas · Houston · Sugar Land · Richmond
        </p>
        <p class="hero-subtitle">
          From half-saree portraits and annaprashan to griha pravesham,
          milestone birthdays, and family reunions, I photograph the warmth,
          ritual, and emotion of your day with a calm, human touch.
        </p>
        <p
          class="body-sm"
          style="max-width: 640px; margin: 0.75rem auto 0; color: var(--cream);"
        >
          The kind of images that feel like home — full of blessings, laughter,
          and the small details you’ll want to revisit for years.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary btn-arrow"
            >Start a Conversation</a
          >
          <a href="#hybrid" class="btn btn-gold-outline btn-arrow"
            >View Hybrid Coverage</a
          >
          <a href="/portfolio" class="btn btn-outline">View Portfolio</a>
        </div>
      </div>

      <div
        class="hero-scroll"
        role="button"
        aria-label="Scroll down"
        tabindex="0"
      >
        <div class="scroll-line"></div>
        <span>Scroll</span>
      </div>
    </section>

    <div class="mobile-cta-bar" aria-label="Quick booking options">
      <a href="/contact" class="btn btn-primary btn-arrow"
        >Start a Conversation</a
      >
      <a href="/contact" class="btn btn-outline">Ask About Film</a>
    </div>

    <div
      style="background: var(--surface); border-bottom: 1px solid var(--border-light); padding: 0.9rem 0; text-align: center;"
    >
      <div
        class="container"
        style="display:flex; align-items:center; justify-content:center; gap: 2rem; flex-wrap: wrap;"
      >
        <span class="location-badge"><span>✦</span> Katy, TX</span>
        <span class="location-badge"><span>✦</span> Cypress</span>
        <span class="location-badge"><span>✦</span> Houston</span>
        <span class="location-badge"><span>✦</span> Sugar Land</span>
        <span class="location-badge"><span>✦</span> Richmond, TX</span>
      </div>
      <address
        style="display:none;"
        itemscope
        itemtype="https://schema.org/LocalBusiness"
      >
        <span itemprop="name">NiO Pictures</span>
        <span itemprop="addressLocality">Katy</span>,
        <span itemprop="addressRegion">TX</span>
        <a href="tel:+12814093585" itemprop="telephone">281-409-3585</a>
        <a href="mailto:niopictureskaty@gmail.com" itemprop="email"
          >niopictureskaty@gmail.com</a
        >
      </address>
    </div>

    <div class="service-split" role="region" aria-label="Photography services">
      <a href="/event-photography-katy-tx" class="service-panel">
        <div
          class="service-panel-bg"
          style={`background-image: url('${homeImages.servicePanelEvents.img.src}'); background-color: #1a1816;`}
        >
        </div>
        <div class="service-panel-overlay"></div>
        <div class="service-panel-content">
          <p class="eyebrow">Corporate · Private · Candid</p>
          <h2 class="service-panel-title">Event<br />Photography</h2>
          <p class="service-panel-desc" aria-hidden="true">
            From cultural celebrations to elegant corporate gatherings, each
            frame is shaped to feel cinematic, warm, and deeply personal.
          </p>
          <span
            class="btn btn-gold-outline btn-arrow"
            style="pointer-events:none;">Explore Events</span
          >
        </div>
      </a>

      <a href="/family-photography-katy-tx" class="service-panel">
        <div
          class="service-panel-bg"
          style={`background-image: url('${homeImages.servicePanelFamily.img.src}'); background-color: #1c1915;`}
        >
        </div>
        <div class="service-panel-overlay"></div>
        <div class="service-panel-content">
          <p class="eyebrow">Portraits · Lifestyle · Legacy</p>
          <h2 class="service-panel-title">Family<br />Heirloom</h2>
          <p class="service-panel-desc" aria-hidden="true">
            Thoughtful portraits and family moments, designed to feel timeless,
            intimate, and worthy of being passed down with love.
          </p>
          <span
            class="btn btn-gold-outline btn-arrow"
            style="pointer-events:none;">Explore Family</span
          >
        </div>
      </a>
    </div>

    <section class="section" id="hybrid" aria-label="Hybrid photo and film">
      <div class="container">
        <div class="hybrid-grid reveal">
          <div>
            <p class="eyebrow">Hybrid Photo + Film</p>
            <h2 class="display-md" style="margin-bottom: 1rem;">
              A fuller way to remember your celebration.
            </h2>
            <p
              class="body-lg"
              style="color: var(--muted); margin-bottom: 1rem;"
            >
              With one calm, intentional photographer, you get both heirloom
              stills and a short cinematic film — the emotion, ritual, and
              movement of the day, captured with warmth and care.
            </p>
