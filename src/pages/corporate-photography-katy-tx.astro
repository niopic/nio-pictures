---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { corporateImages } from "../content/images.config";
const title =
  "Corporate Photography Katy TX | Headshots & Event Coverage | NiO Pictures";
const description =
  "Corporate photography in Katy TX - headshots, conference coverage, and event photography for local businesses.";
const canonical = "https://niopictures.com/corporate-photography-katy-tx";
const ogImage = "https://niopictures.com/assets/images/og-home.webp";
const extraHead =
  '<script type="application/ld+json">\n  {\n    "@context": "https://schema.org",\n    "@type": "BreadcrumbList",\n    "itemListElement": [\n      {"@type":"ListItem","position":1,"name":"Home","item":"https://niopictures.com/"},\n      {"@type":"ListItem","position":2,"name":"Corporate Photography Katy TX","item":"https://niopictures.com/corporate-photography-katy-tx"}\n    ]\n  }\n  </script>\n<script type="application/ld+json">\n  {\n    "@context": "https://schema.org",\n    "@type": "FAQPage",\n    "mainEntity": [\n      {\n        "@type": "Question",\n        "name": "Do you offer on-site corporate headshots?",\n        "acceptedAnswer": {\n          "@type": "Answer",\n          "text": "Yes. We offer on-site headshot sessions for teams of any size in Katy and the greater Houston area."\n        }\n      },\n      {\n        "@type": "Question",\n        "name": "How quickly are corporate photos delivered?",\n        "acceptedAnswer": {\n          "@type": "Answer",\n          "text": "Corporate sessions are typically delivered within 48 hours - faster turnaround can be discussed for time-sensitive needs."\n        }\n      }\n    ]\n  }\n  </script>';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
>
  <Fragment slot="head" set:html={extraHead} />
  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'">Skip to main content</a
  >

  <Nav />

  <div class="page-hero" style="margin-top: 0; padding-top: 0;">
    <div class="page-hero-bg" style="background-color: #18161a;">
      <Image
        src={corporateImages.pageHero.img}
        alt={corporateImages.pageHero.alt}
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1200, 1600, 1920]}
        sizes="100vw"
        quality={90}
        class="page-hero-bg-image"
        style="object-position: top center;"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content container">
      <p class="eyebrow" style="margin-bottom:1rem;">
        Corporate Photography
      </p>
      <div class="gold-line gold-line-animate"></div>
      <h1 class="display-xl" style="max-width:700px; margin-bottom:1.25rem;">
        Corporate<br /><em style="font-style:italic; color:var(--gold);"
          >Photography</em
        >
      </h1>
      <p class="body-lg" style="max-width:580px; margin-bottom:0;">
        Professional headshots, conference coverage, and event photography for businesses in Katy and the greater Houston area.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:800px;">
      <div class="reveal">
        <p
          class="body-lg"
          style="text-align:center; max-width:680px; margin:0 auto;"
        >
          Whether you need on-site headshots, coverage for a conference or
          company event, the same cinematic, professional approach applies.
          Sessions can be scheduled around your team's availability, including
          weekday and weeknight options.
        </p>
      </div>
    </div>
  </section>

  <section class="cta-banner reveal">
    <div class="container">
      <p class="eyebrow" style="margin-bottom:1.25rem;">
        Corporate Photography
      </p>
      <h2
        class="display-md"
        style="margin-bottom:1rem; max-width:520px; margin-left:auto; margin-right:auto;"
      >
        Professional Coverage<br /><em style="font-style:italic; color:var(--gold);"
          >for Your Team</em
        >
      </h2>
      <p class="body-lg" style="max-width:420px; margin:0 auto 2.5rem;">
        Headshots, conferences, and corporate events throughout Katy and the
        greater Houston area.
      </p>
      <div
        style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;"
      >
        <a href="/contact" class="btn btn-primary btn-arrow"
          >Start a Conversation</a
        >
        <a href="/contact" class="btn btn-outline">Get in Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>
