---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { Image } from "astro:assets";
import blogJourney from "../assets/images/blog-journey.webp";
import blogPrepare from "../assets/images/blog-prepare.webp";
import blogBluehour from "../assets/images/blog-bluehour.webp";
import blogEditorialHero from "../assets/images/blog-editorial-hero.webp";
import blogSuitUp from "../assets/images/blog-spring-fling-2026-2.webp";
import blogSpringFling from "../assets/images/blog-spring-fling-2026-1.webp";
const title =
  "Blog | Photography Tips, Stories \u0026 Guides | NiO Pictures Katy TX";
const description =
  "The NiO Pictures blog — photography tips, session guides, behind-the-lens stories, and advice for families and event clients in Katy TX and Houston.";
const canonical = "https://niopictures.com/blog";
const ogImage = "https://niopictures.com/assets/images/og-home.webp";
const extraHead = `<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "NiO Pictures Blog",
    "description": "Photography tips, session guides, and behind-the-lens stories from Palanivel at NiO Pictures in Katy, TX.",
    "url": "https://niopictures.com/blog",
    "publisher": { "@id": "https://niopictures.com/#business" }
  }
  <\/script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://niopictures.com/"},
      {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://niopictures.com/blog"}
    ]
  }
  <\/script>`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  extraStyles={["/assets/css/blog.css"]}
>
  <Fragment slot="head" set:html={extraHead} />
  <a
    href="#main-content"
    class="skip-link"
    style="position:absolute;top:-40px;left:1rem;background:var(--gold);color:var(--black);padding:0.5rem 1rem;border-radius:2px;font-family:var(--font-accent);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;z-index:9999;transition:top var(--dur-fast);"
    onfocus="this.style.top='1rem'"
    onblur="this.style.top='-40px'">Skip to main content</a
  >

  <Nav currentPath="/blog" />

  <!-- ── Header ─────────────────────────────────────────────── -->
  <div class="blog-hero">
    <div class="container">
      <div>
        <p class="eyebrow" style="margin-bottom:1rem;">From the Studio</p>
        <div class="gold-line gold-line-animate"></div>
        <h1 class="display-xl" style="max-width:700px; margin-bottom:1rem;">
          Behind the Lens — Tips, Stories &amp; Session Guides
        </h1>
        <p class="body-lg" style="max-width:520px;">
          Session guides and photography stories from Palanivel, based in Katy,
          TX.
        </p>
      </div>
    </div>
  </div>

  <!-- ── Blog Posts ──────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <!-- Filter tabs -->
      <div class="blog-filters">
        <button class="blog-filter active" data-filter="all">All Posts</button>
        <button class="blog-filter" data-filter="family">Family</button>
        <button class="blog-filter" data-filter="tips">Tips & Guides</button>
        <button class="blog-filter" data-filter="process">Process</button>
        <button class="blog-filter" data-filter="editorial">Editorial</button>
      </div>

      <!-- Featured post -->
      <a
        href="/blog/family-photography-journey"
        class="blog-featured reveal"
        data-cat="process family"
      >
        <div class="blog-featured-img">
          <Image
            src={blogJourney}
            alt="Family photography session journey from booking through heirloom keepsake delivery with NiO Pictures Katy TX"
            widths={[400, 700, 1200]}
            sizes="(max-width: 768px) 100vw, 55vw"
            width={700}
            height={500}
            loading="lazy"
            style="width:100%;height:100%;object-fit:cover;background:var(--surface-2);"
          />
        </div>
        <div class="blog-featured-body">
          <p class="blog-tag">Process · Family</p>
          <h2 class="blog-card-title">
            Your Family Photography Journey with NiO Pictures
          </h2>
          <p class="blog-card-excerpt">
            From easy online booking to beautiful keepsakes — a complete
            walkthrough of what to expect at every step of your family portrait
            experience, including albums, wall art, and prints.
          </p>
          <div class="blog-meta">
            <span>Palanivel</span>
            <span class="blog-meta-dot"></span>
            <span>February 11, 2026</span>
            <span class="blog-meta-dot"></span>
            <span>5 min read</span>
          </div>
          <div class="read-more" style="margin-top:1.5rem;">Read more →</div>
        </div>
      </a>

      <!-- Post grid -->
      <div class="blog-grid">
        <a
          href="/blog/how-to-prepare-family-portrait-session"
          class="blog-card reveal reveal-delay-1"
          data-cat="tips family"
        >
          <div class="blog-card-img">
            <Image
              src={blogPrepare}
              alt="Family preparing outfits and styling for a portrait session in Katy TX — tips for what to wear to family photos"
              widths={[300, 600, 900]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, calc(50% - 1rem)"
              width={600}
              height={338}
              loading="lazy"
              style="width:100%;height:100%;object-fit:cover;background:var(--surface-2);"
            />
          </div>
          <div class="blog-card-body">
            <p class="blog-tag">Tips & Guides · Family</p>
            <h2 class="blog-card-title">
              How to Prepare for Your Katy Family Portrait Session
            </h2>
            <p class="blog-card-excerpt">
              Color coordination, what to wear, grooming tips for everyone —
              kids, adults, and even the family pet. Everything you need to feel
              confident and relaxed on session day.
            </p>
            <div class="blog-meta" style="margin-bottom:0.75rem;">
              <span>February 6, 2026</span>
              <span class="blog-meta-dot"></span>
              <span>4 min read</span>
            </div>
            <div class="read-more">Read more →</div>
          </div>
        </a>

        <a
          href="/blog/blue-hour-holiday-portraits"
          class="blog-card reveal reveal-delay-2"
          data-cat="family tips"
        >
          <div class="blog-card-img">
            <Image
              src={blogBluehour}
              alt="Blue hour holiday family portraits in front yard with string lights during dusk in Katy TX"
              widths={[300, 600, 900]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, calc(50% - 1rem)"
              width={600}
              height={338}
              loading="lazy"
              style="width:100%;height:100%;object-fit:cover;background:var(--surface-2);"
            />
          </div>
          <div class="blog-card-body">
            <p class="blog-tag">Family · Holiday</p>
            <h2 class="blog-card-title">
              Blue Hour Front-Yard Holiday Portraits
            </h2>
            <p class="blog-card-excerpt">
              You don't need a studio or a fancy location. Your front yard, your
              holiday lights, and the quiet magic of blue hour — that's all it
              takes for portraits that feel truly special.
            </p>
            <div class="blog-meta" style="margin-bottom:0.75rem;">
              <span>December 9, 2025</span>
              <span class="blog-meta-dot"></span>
              <span>3 min read</span>
            </div>
            <div class="read-more">Read more →</div>
          </div>
        </a>

        <a
          href="/blog/editorial-portrait-photography"
          class="blog-card reveal reveal-delay-3"
          data-cat="editorial"
        >
          <div class="blog-card-img">
            <Image
              src={blogEditorialHero}
              alt="Editorial portrait photography session with bold controlled-shadow lighting for personal branding Katy TX Houston"
              widths={[300, 600, 900]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, calc(50% - 1rem)"
              width={600}
              height={338}
              loading="lazy"
              style="width:100%;height:100%;object-fit:cover;background:var(--surface-2);"
            />
          </div>
          <div class="blog-card-body">
            <p class="blog-tag">Editorial · Branding</p>
            <h2 class="blog-card-title">
              Shaping Light — A Study in Editorial Portrait Photography
            </h2>
            <p class="blog-card-excerpt">
              Strong shape, controlled shadows, a touch of color. A personal
              exploration of editorial lighting and what it means to make a
              portrait that commands presence.
            </p>
            <div class="blog-meta" style="margin-bottom:0.75rem;">
              <span>January 9, 2026</span>
              <span class="blog-meta-dot"></span>
              <span>3 min read</span>
            </div>
            <div class="read-more">Read more →</div>
          </div>
        </a>

        <a
          href="/blog/suited-up-golden-hour-river-green-park"
          class="blog-card reveal reveal-delay-4"
          data-cat="family community event"
        >
          <div class="blog-card-img">
            <Image
              src={blogSuitUp}
              alt="Boys in suits at River Green Park during golden hour, community portrait photography in Katy TX"
              widths={[300, 600, 900]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, calc(50% - 1rem)"
              width={600}
              height={338}
              loading="lazy"
              style="width:100%;height:100%;object-fit:cover;background:var(--surface-2);"
            />
          </div>
          <div class="blog-card-body">
            <p class="blog-tag">Family · Community · Event</p>
            <h2 class="blog-card-title">
              Suited Up at Golden Hour: Grad Boys Portraits at River Green Park
            </h2>
            <p class="blog-card-excerpt">
              A community-driven portrait session for eight grad boys from Cinco
              Ranch and King Lakes, captured in warm golden hour light at River
              Green Park.
            </p>
            <div class="blog-meta" style="margin-bottom:0.75rem;">
              <span>May 2, 2026</span>
              <span class="blog-meta-dot"></span>
              <span>4 min read</span>
            </div>
            <div class="read-more">Read more →</div>
          </div>
        </a>

        <a
          href="/blog/spring-fling-st-peters-ecdc-katy-tx"
          class="blog-card reveal reveal-delay-5"
          data-cat="event community"
        >
          <div class="blog-card-img">
            <Image
              src={blogSpringFling}
              alt="Spring Fling community event at St. Peter's ECDC in Katy TX — families, children, and joyful moments"
              widths={[300, 600, 900]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, calc(50% - 1rem)"
              width={600}
              height={338}
              loading="lazy"
              style="width:100%;height:100%;object-fit:cover;background:var(--surface-2);"
            />
          </div>
          <div class="blog-card-body">
            <p class="blog-tag">Event · Community</p>
            <h2 class="blog-card-title">
              Capturing Community: Spring Fling at St. Peter's ECDC, Katy TX
            </h2>
            <p class="blog-card-excerpt">
              Families, face painting, balloon animals, and genuine moments. A
              community event done right — photographed as a volunteer for St.
              Peter's ECDC on Kingsland Blvd.
            </p>
            <div class="blog-meta" style="margin-bottom:0.75rem;">
              <span>April 21, 2026</span>
              <span class="blog-meta-dot"></span>
              <span>4 min read</span>
            </div>
            <div class="read-more">Read more →</div>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
