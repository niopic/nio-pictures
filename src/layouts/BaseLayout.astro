---
import { buildOfferCatalog } from "../data/pricing";
import logoImage from "../assets/images/logo.png";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
  extraStyles?: string[];
  deferComponentsCss?: boolean;
}

const {
  title,
  description,
  canonical = "https://niopictures.com/",
  ogImage = "https://niopictures.com/assets/images/og-home.webp",
  noIndex = false,
  extraStyles = [],
  deferComponentsCss = false,
} = Astro.props;

const currentYear = new Date().getFullYear();

const businessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService", "PhotographyStudio"],
  "@id": "https://niopictures.com/#business",
  name: "NiO Pictures",
  alternateName: "NiO Pictures Photography",
  description,
  url: "https://niopictures.com/",
  telephone: "+12814093585",
  email: "niopictureskaty@gmail.com",
  founder: { "@type": "Person", name: "Palanivel" },
  priceRange: "$$$",
  paymentAccepted: "Cash, Credit Card, Venmo",
  currenciesAccepted: "USD",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Katy",
    addressRegion: "TX",
    postalCode: "77494",
    addressCountry: "US",
  },
  geo: { "@type": "GeoCoordinates", latitude: "29.7858", longitude: "-95.8245" },
  areaServed: [
    { "@type": "City", name: "Katy", sameAs: "https://en.wikipedia.org/wiki/Katy,_Texas" },
    { "@type": "City", name: "Cypress" },
    { "@type": "City", name: "Houston", sameAs: "https://en.wikipedia.org/wiki/Houston" },
    { "@type": "City", name: "Sugar Land", sameAs: "https://en.wikipedia.org/wiki/Sugar_Land,_Texas" },
    { "@type": "City", name: "Richmond", sameAs: "https://en.wikipedia.org/wiki/Richmond,_Texas" },
  ],
  keywords: [
    "premium family photography",
    "event photographer",
    "South Asian celebration photography",
    "hybrid photo and film",
    "Katy TX photographer",
  ],
  image: ogImage,
  sameAs: [
    "https://www.instagram.com/nio_pictures",
    "https://www.facebook.com/profile.php?id=61580596898855",
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5.0",
    reviewCount: "16",
    bestRating: "5",
    worstRating: "1",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday", "Sunday"],
      opens: "09:00",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "18:00",
      closes: "21:00",
    },
  ],
  hasOfferCatalog: buildOfferCatalog(),
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://niopictures.com/#organization",
  name: "NiO Pictures",
  url: "https://niopictures.com",
  logo: {
    "@type": "ImageObject",
    url: `https://niopictures.com${logoImage.src}`,
  },
  foundingDate: "2017",
  founder: { "@type": "Person", name: "Palanivel" },
  sameAs: businessSchema.sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Katy, Texas" />
    <meta name="geo.position" content="29.7858;-95.8245" />
    <meta name="ICBM" content="29.7858, -95.8245" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="NiO Pictures — Cinematic Event & Family Photography in Katy TX"
    />
    <meta property="og:site_name" content="NiO Pictures" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@nio_pictures" />
    <meta name="twitter:creator" content="@nio_pictures" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Cinzel:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Cinzel:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Cinzel:wght@400;500&display=swap"
      />
    </noscript>

    <link rel="preload" as="style" href="/assets/css/global.css" />
    <link
      rel="stylesheet"
      href="/assets/css/global.css"
      media="print"
      onload="this.media='all'"
    />

    {
      deferComponentsCss ? (
        <Fragment>
          <link rel="preload" as="style" href="/assets/css/components.css" />
          <link
            rel="stylesheet"
            href="/assets/css/components.css"
            media="print"
            onload="this.media='all'"
          />
        </Fragment>
      ) : (
        <link rel="stylesheet" href="/assets/css/components.css" />
      )
    }

    <link rel="preload" as="style" href="/assets/css/animations.css" />
    <link
      rel="stylesheet"
      href="/assets/css/animations.css"
      media="print"
      onload="this.media='all'"
    />

    <noscript>
      <link rel="stylesheet" href="/assets/css/global.css" />
      <link rel="stylesheet" href="/assets/css/components.css" />
    </noscript>

    <noscript>
      <link rel="stylesheet" href="/assets/css/animations.css" />
    </noscript>

    {
      extraStyles.map((href) => (
        <Fragment>
          <link rel="preload" as="style" href={href} />
          <link
            rel="stylesheet"
            href={href}
            media="print"
            onload="this.media='all'"
          />
        </Fragment>
      ))
    }

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#161412" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(businessSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationSchema)}
    />
    <slot name="head" />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.addEventListener(
        "load",
        () => {
          let analyticsLoaded = false;
          const interactionEvents = ["pointerdown", "keydown", "submit"];

          const loadAnalytics = () => {
            if (analyticsLoaded) return;
            analyticsLoaded = true;
            interactionEvents.forEach((eventName) => {
              window.removeEventListener(eventName, loadAnalytics, true);
            });

            const script = document.createElement("script");
            script.src =
              "https://www.googletagmanager.com/gtag/js?id=G-1VZ3GPSWGH";
            script.async = true;
            document.head.appendChild(script);
            gtag("js", new Date());
            gtag("config", "G-1VZ3GPSWGH");
          };

          interactionEvents.forEach((eventName) => {
            window.addEventListener(eventName, loadAnalytics, {
              once: true,
              capture: true,
              passive: true,
            });
          });
        },
        { once: true },
      );
    </script>
  </head>
  <body>
    <slot />

    <footer class="footer" role="contentinfo">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="nav-logo">Ni<span>O</span> PICTURES</a>
            <p>
              Cinematic photography and film for South Asian milestone
              celebrations. Based in Katy, TX, serving Katy, Fulshear, Cypress,
              Sugar Land, Richmond, and Houston.
            </p>
          </div>

          <div>
            <p class="footer-heading">Services</p>
            <nav class="footer-links" aria-label="Service links">
              <a href="/event-photography-katy-tx">Celebrations</a>
              <a href="/family-photography-katy-tx">Family Sessions</a>
              <a href="/housewarming-photography-katy-tx">Housewarming</a>
              <a href="/half-saree-photography-katy-tx">Half-Saree</a>
              <a href="/videography-katy-tx">Photography &amp; Film</a>
              <a
                href="https://niopictures.pixieset.com/"
                target="_blank"
                rel="noopener noreferrer">View Gallery</a
              >
            </nav>
          </div>

          <div>
            <p class="footer-heading">Navigate</p>
            <nav class="footer-links" aria-label="Site links">
              <a href="/about">About</a>
              <a href="/book">Book a Session</a>
              <a href="/contact">Contact</a>
              <a href="/blog">Blog</a>
              <a href="/portfolio">Portfolio</a>
            </nav>
          </div>

          <div>
            <p class="footer-heading">Locations</p>
            <nav class="footer-links">
              <a href="/katy-tx-photographer">Katy TX</a>
              <a href="/fulshear-tx-photographer">Fulshear TX</a>
              <a href="/cypress-tx-photographer">Cypress TX</a>
              <a href="/sugar-land-photographer">Sugar Land</a>
              <a href="/richmond-tx-photographer">Richmond TX</a>
              <a href="/houston-tx-photographer">Houston TX</a>
            </nav>
          </div>

          <div class="footer-contact">
            <p class="footer-heading">Contact</p>
            <p>
              Katy, Texas<br />
              Serving Greater Houston Area<br />
              Katy - Cypress - Sugar Land - Richmond - Houston
            </p>
            <p style="margin-top: 1rem; line-height: 2.2;">
              <a href="tel:+12814093585" style="display:block;"
                >Phone 281-409-3585</a
              >
              <a href="mailto:niopictureskaty@gmail.com" style="display:block;"
                >Email niopictureskaty@gmail.com</a
              >
              <a
                href="https://www.instagram.com/nio_pictures"
                target="_blank"
                rel="noopener noreferrer"
                style="display:block;">Instagram @nio_pictures</a
              >
              <a
                href="https://niopictures.pixieset.com/booking/"
                target="_blank"
                rel="noopener noreferrer"
                style="display:block;">Self-Book Online</a
              >
            </p>
          </div>
        </div>

        <div
          style="border-top:1px solid var(--border-light);padding:1rem 0;margin-bottom:1rem;"
        >
          <p style="font-size:0.75rem;color:var(--muted);line-height:1.6;">
            This site uses Google Analytics to understand how visitors use our
            pages. No personal data is sold.
            <a href="/privacy" style="color:var(--muted);">Privacy Policy</a>
            &middot;
            <a href="/terms" style="color:var(--muted);">Terms</a>
          </p>
        </div>

        <div class="footer-bottom">
          <p class="footer-copy">
            &copy; {currentYear}
            <span>NiO Pictures</span> - Palanivel. All rights reserved. Katy, TX.
          </p>
          <div class="footer-legal">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <div class="mobile-cta-bar" aria-label="Quick booking options">
      <a href="/contact" class="btn btn-primary btn-arrow">Start a Conversation</a>
      <a href="tel:+12814093585" class="btn btn-outline">Call Now</a>
    </div>

    <script src="/assets/js/main.js" defer></script>
    <script is:inline>
      (() => {
        const chatWidgetUrl = "https://chat.niopictures.com/widget.js";
        const interactionEvents = [
          "pointerdown",
          "keydown",
          "touchstart",
          "focusin",
        ];
        let chatLoaded = false;

        const loadChatWidget = () => {
          if (chatLoaded) return;
          chatLoaded = true;

          interactionEvents.forEach((eventName) => {
            window.removeEventListener(eventName, loadChatWidget, true);
          });

          const script = document.createElement("script");
          script.src = chatWidgetUrl;
          script.async = true;
          document.body.appendChild(script);
        };

        interactionEvents.forEach((eventName) => {
          window.addEventListener(eventName, loadChatWidget, {
            once: true,
            capture: true,
            passive: true,
          });
        });

        window.addEventListener(
          "load",
          () => {
            const scheduleLoad = () => window.setTimeout(loadChatWidget, 2500);

            if ("requestIdleCallback" in window) {
              window.requestIdleCallback(scheduleLoad, { timeout: 3000 });
            } else {
              scheduleLoad();
            }
          },
          { once: true },
        );
      })();
    </script>
  </body>
</html>
